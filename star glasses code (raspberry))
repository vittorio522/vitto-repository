#!/usr/bin/env python3
"""
AR SKYMAP - Raspberry Pi 5 + Camera + BNO055
==============================================
Occhiali AR: sovrappone la posizione reale delle stelle sul feed
della fotocamera, in base all'orientamento letto dal BNO055.

HARDWARE:
 - Raspberry Pi 5
 - Camera Module (Pi Camera v2/v3, via CSI, usando picamera2)
 - BNO055 su I2C1 (SDA=GPIO2 pin3, SCL=GPIO3 pin5)
 - Display di output: qualunque schermo HDMI/USB collegato agli
   occhiali (per un display SPI/mini-HDMI dedicato si sostituisce
   la funzione show_frame() in fondo)

INSTALLAZIONE:
    sudo raspi-config          # Interface Options -> I2C -> Enable
                                # Interface Options -> Camera -> Enable
    sudo apt update
    sudo apt install -y python3-opencv python3-picamera2 i2c-tools
    pip3 install adafruit-circuitpython-bno055 adafruit-blinka

TEST PRELIMINARE (fai questo PRIMA di lanciare lo script):
    sudo i2cdetect -y 1        # deve mostrare 28 o 29
    libcamera-hello --list-cameras   # verifica che la camera sia vista

CONFIGURAZIONE POSIZIONE/ORA:
 Modifica le costanti LAT / LON qui sotto, oppure collega un modulo
 GPS USB/UART e usa gps_reader.py (vedi nota in fondo al file).
"""

import time
import math
import datetime

import cv2
import numpy as np
import board
import busio
import adafruit_bno055

from picamera2 import Picamera2

