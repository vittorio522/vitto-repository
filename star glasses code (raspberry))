# ---------------- ASTRONOMIA ----------------
def julian_date(dt_utc):
    y, mo, d = dt_utc.year, dt_utc.month, dt_utc.day
    ut = dt_utc.hour + dt_utc.minute / 60.0 + dt_utc.second / 3600.0
    jd = (367.0 * y
          - math.floor(7.0 * (y + math.floor((mo + 9.0) / 12.0)) / 4.0)
          + math.floor(275.0 * mo / 9.0)
          + d + 1721013.5 + ut / 24.0)
    return jd


def local_sidereal_time(jd, lon_deg):
    T = (jd - 2451545.0) / 36525.0
    gmst = (280.46061837 + 360.98564736629 * (jd - 2451545.0)
            + 0.000387933 * T * T - (T ** 3) / 38710000.0)
    lst = (gmst + lon_deg) % 360.0
    return lst


def compute_alt_az(ra_deg, dec_deg, lat_deg, lst_deg):
    H = (lst_deg - ra_deg) % 360.0
    Hrad = math.radians(H)
    dec_rad = math.radians(dec_deg)
    lat_rad = math.radians(lat_deg)

    sin_alt = (math.sin(dec_rad) * math.sin(lat_rad)
               + math.cos(dec_rad) * math.cos(lat_rad) * math.cos(Hrad))
    alt = math.asin(max(-1.0, min(1.0, sin_alt)))

    denom = math.cos(alt) * math.cos(lat_rad)
    if abs(denom) < 1e-6:
        az = 0.0
    else:
        cos_a = (math.sin(dec_rad) - math.sin(alt) * math.sin(lat_rad)) / denom
        cos_a = max(-1.0, min(1.0, cos_a))
        A = math.acos(cos_a)
        az = (360.0 - math.degrees(A)) if math.sin(Hrad) > 0 else math.degrees(A)

    return math.degrees(alt), az


def norm180(deg):
    deg = deg % 360.0
    if deg > 180.0:
        deg -= 360.0
    return deg


# ---------------- BNO055 ----------------
def init_bno():
    i2c = busio.I2C(board.SCL, board.SDA)
    sensor = adafruit_bno055.BNO055_I2C(i2c)
    return sensor


def read_orientation(sensor):
    """Ritorna (heading, pitch) in gradi. Adatta qui se orientamento
    montato sugli occhiali risulta invertito/scambiato."""
    euler = sensor.euler
    if euler is None or euler[0] is None:
        return None, None
    heading, roll, pitch = euler
    heading = heading % 360.0
    return heading, pitch


# ---------------- OVERLAY SULLA CAMERA ----------------
def draw_overlay(frame, heading, pitch, lat, lon):
    now = datetime.datetime.utcnow()
    jd = julian_date(now)
    lst = local_sidereal_time(jd, lon)

    h, w = frame.shape[:2]

    for name, ra, dec, mag in STAR_CATALOG:
        alt, az = compute_alt_az(ra, dec, lat, lst)
        if alt < 0:
            continue  # sotto l'orizzonte

        az_diff = norm180(az - heading)
        alt_diff = alt - pitch

        if abs(az_diff) > FOV_H_DEG / 2.0 or abs(alt_diff) > FOV_V_DEG / 2.0:
            continue

        x = int(w / 2 + (az_diff / (FOV_H_DEG / 2.0)) * (w / 2.0))
        y = int(h / 2 - (alt_diff / (FOV_V_DEG / 2.0)) * (h / 2.0))

        if not (0 <= x < w and 0 <= y < h):
            continue

        radius = 5 if mag < 0.0 else (3 if mag < 1.0 else 2)
        cv2.circle(frame, (x, y), radius, (255, 255, 255), -1)

        if mag < 1.0:
            cv2.putText(frame, name, (x + 6, y + 4),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.4, (255, 255, 255), 1, cv2.LINE_AA)

    # overlay info in alto a sinistra
    info = f"Az:{heading:5.1f}  Alt:{pitch:5.1f}"
    cv2.putText(frame, info, (10, 20),
                cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 255, 0), 1, cv2.LINE_AA)

    return frame


# ---------------- MAIN LOOP ----------------
def main():
    print("Inizializzazione BNO055...")
    bno = init_bno()

    print("Inizializzazione fotocamera...")
    picam2 = Picamera2()
    config = picam2.create_preview_configuration(
        main={"size": (FRAME_W, FRAME_H), "format": "RGB888"}
    )
    picam2.configure(config)
    picam2.start()
    time.sleep(1)

    print("Pronto. Premi 'q' per uscire.")

    try:
        while True:
            frame = picam2.capture_array()

            heading, pitch = read_orientation(bno)
            if heading is not None:
                frame = draw_overlay(frame, heading, pitch, LAT, LON)
            else:
                cv2.putText(frame, "BNO055: calibrazione...", (10, 20),
                            cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 0, 255), 1, cv2.LINE_AA)

            cv2.imshow("AR Skymap", frame)
            if cv2.waitKey(1) & 0xFF == ord('q'):
                break

    finally:
        picam2.stop()
        cv2.destroyAllWindows()


if __name__ == "__main__":
    main()
