// ---------------- POSIZIONE / DATA-ORA ----------------
double latitude = 45.4384;   // valore di partenza, sovrascritto da seriale
double longitude = 12.3271;
int  yearUTC = 2026, monthUTC = 1, dayUTC = 1;
int  hourUTC = 0, minuteUTC = 0, secondUTC = 0;

bool coordinatesSet = false; // true quando lat/lon sono validi (da seriale)
bool timeSet = false;        // true quando data/ora sono valide (da seriale)

// Riempie fino a `count` valori float separati da virgola in `line`.
// Ritorna false se la riga non contiene abbastanza campi.
bool parseCSVLine(const String &line, float *vals, int count) {
  int start = 0;
  for (int i = 0; i < count; i++) {
    int comma = (i == count - 1) ? line.length() : line.indexOf(',', start);
    if (comma == -1) return false;
    vals[i] = line.substring(start, comma).toFloat();
    start = comma + 1;
  }
  return true;
}

void readDataFromSerial() {
  if (!Serial.available()) return;

  String line = Serial.readStringUntil('\n');
  line.trim();
  if (line.length() == 0) return;

  float vals[8];
  if (!parseCSVLine(line, vals, 8)) {
    Serial.println(F("Formato: lat,lon,YYYY,MM,DD,hh,mm,ss  (ora in UTC)"));
    Serial.println(F("Esempio: 44.8354,11.6198,2026,7,13,19,30,0"));
    return;
  }

  latitude  = vals[0];
  longitude = vals[1];
  yearUTC   = (int)vals[2];
  monthUTC  = (int)vals[3];
  dayUTC    = (int)vals[4];
  hourUTC   = (int)vals[5];
  minuteUTC = (int)vals[6];
  secondUTC = (int)vals[7];

  coordinatesSet = true;
  timeSet = true;

  Serial.println(F("Dati aggiornati:"));
  Serial.print(F("Lat=")); Serial.print(latitude, 6);
  Serial.print(F(" Lon=")); Serial.println(longitude, 6);
}

// ---------------- MPU6050 ----------------
#define MPU_ADDR 0x68
#define BUTTON_PIN 2

float heading = 0.0;      // azimuth stimato (gradi, 0=Nord, orario)
float gyroZOffset = 0.0;
unsigned long lastMicros = 0;

// ultimo campione letto dall'MPU, condiviso da updateOrientation() e readTiltPitch()
int16_t lastAx, lastAy, lastAz, lastGx, lastGy, lastGz;

// ---------------- CAMPO VISIVO ----------------
const float FOV_H = 60.0; // gradi orizzontali
const float FOV_V = 30.0; // gradi verticali (coerente con aspect ratio 2:1)

// ---------------- CATALOGO STELLE ----------------
struct StarData {
  float ra;
  float dec;
  float mag;
};

const StarData catalog[] PROGMEM = {
  {101.287, -16.716, -1.46}, // Sirius
  { 95.988, -52.696, -0.72}, // Canopus
  {219.902, -60.834, -0.27}, // Alpha Centauri
