SATELLITES = []

def fetch_satellites_background():
    """Scarica i satelliti in un thread separato per non bloccare il boot."""
    global SATELLITES
    if not HAS_EPHEM:
        return
        
    sat_list = [
        ("ISS (ZARYA)", "https://celestrak.org/NORAD/elements/gp.php?CATNR=25544&FORMAT=tle"),
        ("HST (Hubble)", "https://celestrak.org/NORAD/elements/gp.php?CATNR=20580&FORMAT=tle"),
        ("CSS (Tiangong)", "https://celestrak.org/NORAD/elements/gp.php?CATNR=48274&FORMAT=tle")
    ]
    
    temp_sats = []
    for name, url in sat_list:
        try:
            logging.info(f"Recupero dati TLE per {name}...")
            with urllib.request.urlopen(url, timeout=3) as response:
                lines = response.read().decode('utf-8').splitlines()
                if len(lines) >= 3:
                    sat = ephem.readtle(name, lines[1].strip(), lines[2].strip())
                    temp_sats.append({"name": name, "ephem": sat, "az": 0.0, "alt": 0.0, "mag": -2.0, "type": "satellite"})
        except Exception:
            logging.warning(f"Impossibile scaricare TLE per {name}. Salto satellite.")
    
    SATELLITES = temp_sats
    logging.info(f"Caricamento satelliti completato. Totale: {len(SATELLITES)}")

def update_celestial_positions(lat, lon):
    if not HAS_EPHEM:
        return
    observer = ephem.Observer()
    observer.lat = str(lat)
    observer.lon = str(lon)
    observer.elevation = 0
    observer.date = datetime.datetime.now(datetime.timezone.utc)

    for obj in CELESTIAL_CATALOG:
        if obj["type"] in ["planet", "star", "deep_sky"] and obj["ephem"] is not None:
            try:
                obj["ephem"].compute(observer)
                obj["az"] = math.degrees(obj["ephem"].az)
                obj["alt"] = math.degrees(obj["ephem"].alt)
            except Exception:
                pass

def update_satellite_positions(lat, lon):
    if not HAS_EPHEM or not SATELLITES:
        return
    observer = ephem.Observer()
    observer.lat = str(lat)
    observer.lon = str(lon)
    observer.elevation = 0
    observer.date = datetime.datetime.now(datetime.timezone.utc)

    for obj in SATELLITES:
        if obj["ephem"] is not None:
            try:
                obj["ephem"].compute(observer)
                obj["az"] = math.degrees(obj["ephem"].az)
                obj["alt"] = math.degrees(obj["ephem"].alt)
            except Exception:
                pass

def get_cpu_temperature():
    try:
        if os.path.exists('/sys/class/thermal/thermal_zone0/temp'):
            with open('/sys/class/thermal/thermal_zone0/temp', 'r') as f:
                return float(f.read().strip()) / 1000.0
    except Exception:
        pass
    return None


