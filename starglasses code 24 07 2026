def project_az_alt(az, alt, yaw, pitch, cx, cy):
    delta_az = (az - yaw + 180) % 360 - 180
    delta_alt = alt - pitch
    x = cx + (delta_az * PX_PER_DEG_X)
    y = cy - (delta_alt * PX_PER_DEG_Y)
    is_visible = (-50 <= x <= SCREEN_WIDTH + 50) and (-50 <= y <= SCREEN_HEIGHT + 50)
    return int(x), int(y), is_visible, delta_az, delta_alt

def draw_crosshair(surface, cx, cy, col):
    pygame.draw.line(surface, col, (cx - 20, cy), (cx + 20, cy), 2)
    pygame.draw.line(surface, col, (cx, cy - 20), (cx, cy + 20), 2)
    pygame.draw.circle(surface, col, (cx, cy), 12, 1)

def draw_offscreen_arrow(surface, delta_az, delta_alt, cx, cy, col):
    angle = math.atan2(-delta_alt, delta_az)
    margin = 40
    arrow_x = int(cx + (cx - margin) * math.cos(angle))
    arrow_y = int(cy + (cy - margin) * math.sin(angle))
    arrow_x = max(margin, min(SCREEN_WIDTH - margin, arrow_x))
    arrow_y = max(margin, min(SCREEN_HEIGHT - margin, arrow_y))

    size = 14
    p1 = (arrow_x + int(size * math.cos(angle)), arrow_y + int(size * math.sin(angle)))
    p2 = (arrow_x + int(size * math.cos(angle + 2.5)), arrow_y + int(size * math.sin(angle + 2.5)))
    p3 = (arrow_x + int(size * math.cos(angle - 2.5)), arrow_y + int(size * math.sin(angle - 2.5)))
    
    pygame.draw.polygon(surface, col, [p1, p2, p3])
    pygame.draw.circle(surface, col, (arrow_x, arrow_y), 18, 1)

def draw_compass(surface, yaw, colors):
    cx, cy, radius = SCREEN_WIDTH - 90, SCREEN_HEIGHT - 90, 50
    pygame.draw.circle(surface, colors["bg"], (cx, cy), radius)
    pygame.draw.circle(surface, colors["hud"], (cx, cy), radius, 2)

    n_lbl = font_small.render("N", True, colors["warn"])
    s_lbl = font_small.render("S", True, colors["hud"])
    e_lbl = font_small.render("E", True, colors["hud"])
    w_lbl = font_small.render("W", True, colors["hud"])

    surface.blit(n_lbl, (cx - n_lbl.get_width() // 2, cy - radius - 2))
    surface.blit(s_lbl, (cx - s_lbl.get_width() // 2, cy + radius - 14))
    surface.blit(e_lbl, (cx + radius - 14, cy - e_lbl.get_height() // 2))
    surface.blit(w_lbl, (cx - radius + 2, cy - e_lbl.get_height() // 2))

    angle_rad = math.radians(yaw - 90)
    tip_x = cx + int((radius - 12) * math.cos(angle_rad))
    tip_y = cy + int((radius - 12) * math.sin(angle_rad))
    
    pygame.draw.line(surface, colors["target"], (cx, cy), (tip_x, tip_y), 3)
    pygame.draw.circle(surface, colors["target"], (cx, cy), 4)

    val_txt = font_small.render(f"{int(yaw)}°", True, colors["hud"])
    surface.blit(val_txt, (cx - val_txt.get_width() // 2, cy + radius + 4))

def draw_telemetry(surface, yaw, pitch, lat, lon, gps_ok, target_obj, delta_az, delta_alt, cpu_temp, colors):
    surface.blit(font_hud.render(f"YAW:   {yaw:05.1f}° (OFF: {state['yaw_offset']:+.1f}°)", True, colors["hud"]), (20, 20))
    surface.blit(font_hud.render(f"PITCH: {pitch:05.1f}°", True, colors["hud"]), (20, 45))
    
    gps_str = "GPS: FIX OK" if gps_ok else "GPS: SEARCHING..."
    gps_col = colors["hud"] if gps_ok else colors["warn"]
    surface.blit(font_hud.render(gps_str, True, gps_col), (20, 70))

    if cpu_temp is not None:
        temp_col = colors["hud"] if cpu_temp < 65.0 else colors["orange"] if cpu_temp < 80.0 else colors["warn"]
        surface.blit(font_hud.render(f"CPU: {cpu_temp:.1f}°C", True, temp_col), (20, 95))

    surface.blit(font_hud.render(f"LAT: {lat:.4f}", True, colors["hud"]), (20, SCREEN_HEIGHT - 65))
    surface.blit(font_hud.render(f"LON: {lon:.4f}", True, colors["hud"]), (20, SCREEN_HEIGHT - 40))

    dist_angle = math.sqrt(delta_az**2 + delta_alt**2)
    box_x = SCREEN_WIDTH - 380
    surface.blit(font_big.render(f"TARGET: {target_obj['name'].upper()}", True, colors["target"]), (box_x, 20))
    surface.blit(font_hud.render(f"AZ: {target_obj['az']:.1f}° | ALT: {target_obj['alt']:.1f}°", True, colors["target"]), (box_x, 50))
    surface.blit(font_hud.render(f"DISTANCE: {dist_angle:.1f}°", True, colors["target"]), (box_x, 75))
    surface.blit(font_small.render("[SPACE] Next | [C] Calib | [B] Cam | [N] Night | [R] Swap", True, colors["hud"]), (box_x, 105))


