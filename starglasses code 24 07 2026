def create_fixed_body(ra, dec, name):
    if not HAS_EPHEM:
        return None
    body = ephem.FixedBody()
    body._ra = ephem.hours(ra)
    body._dec = ephem.degrees(dec)
    body._epoch = ephem.J2000
    return body

