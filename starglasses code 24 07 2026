# 7. LOOP PRINCIPALE
# ==========================================
last_astro_update = 0
last_sat_update = 0
last_hw_update = 0
last_blink_toggle = 0
clock = pygame.time.Clock()
running = True

# Schermata di caricamento iniziale
screen.fill((0,0,0))
loading_text = font_big.render("CARICAMENTO STARGLASSES AR...", True, (0, 255, 0))
screen.blit(loading_text, (SCREEN_WIDTH//2 - loading_text.get_width()//2, SCREEN_HEIGHT//2))
pygame.display.flip()

logging.info("StarGlasses AR - Avvio sistema completato.")

try:
    while running:
        colors = get_colors()
        now = time.time()

        if now - last_blink_toggle >= 0.5:
            state["sat_blink_toggle"] = not state["sat_blink_toggle"]
            last_blink_toggle = now

        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                running = False
            elif event.type == pygame.KEYDOWN:
                if event.key == pygame.K_ESCAPE:
                    running = False
                elif event.key in (pygame.K_SPACE, pygame.K_TAB):
                    state["target_index"] = (state["target_index"] + 1) % (len(CELESTIAL_CATALOG) + len(SATELLITES))
                elif event.key == pygame.K_c:
                    target_az = (CELESTIAL_CATALOG + SATELLITES)[state["target_index"]]["az"]
                    state["yaw_offset"] = target_az - raw_yaw
                    state["calib_msg_frames"] = 90
                elif event.key == pygame.K_b:
                    state["show_camera"] = not state["show_camera"]
                elif event.key == pygame.K_n:
                    state["night_mode"] = not state["night_mode"]
                elif event.key == pygame.K_r:
                    # Tasto R per invertire i colori della camera se appaiono invertiti (effetto puffi)
                    state["swap_colors"] = not state["swap_colors"]

        if bno is not None:
            try:
                euler = bno.euler
                if euler[0] is not None:
                    raw_yaw = euler[0]
                    current_yaw = (raw_yaw + state["yaw_offset"]) % 360
                    current_pitch = euler[2]
            except Exception:
                pass

        if gps_serial is not None and gps_serial.in_waiting > 0:
            try:
                line = gps_serial.readline().decode('ascii', errors='replace')
                if line.startswith('$GPGGA') or line.startswith('$GNGGA'):
                    msg = pynmea2.parse(line)
                    if msg.gps_qual > 0:
                        current_lat = msg.latitude
                        current_lon = msg.longitude
                        gps_fix = True
            except Exception:
                pass

        if now - last_astro_update >= 5.0:
            update_celestial_positions(current_lat, current_lon)
            last_astro_update = now
            
        if now - last_sat_update >= 0.2:
            update_satellite_positions(current_lat, current_lon)
            last_sat_update = now

        if now - last_hw_update >= 3.0:
            cpu_temperature = get_cpu_temperature()
            last_hw_update = now

        if cpu_temperature is not None and cpu_temperature >= 85.0:
            screen.fill(colors["bg"])
            crit_text = font_big.render("CRITICAL TEMPERATURE - SHUTTING DOWN!", True, colors["warn"])
            screen.blit(crit_text, (SCREEN_WIDTH // 2 - crit_text.get_width() // 2, SCREEN_HEIGHT // 2))
            pygame.display.flip()
            time.sleep(3.0)
            running = False
            break

        # --- RENDERING VIDEO & HUD ---
        if state["show_camera"] and HAS_PICAMERA2 and picam2 is not None:
            try:
                frame = picam2.capture_array()
                
                # Se l'opzione swap_colors è attiva, invertiamo i canali BGR in RGB
                if state["swap_colors"]:
                    frame = frame[:, :, ::-1]
                
                # Ora frame è in formato RGB standard. Indici: 0=Rosso, 1=Verde, 2=Blu
                if state["night_mode"]:
                    frame[:, :, 1] = 0  # Azzera il Verde
                    frame[:, :, 2] = 0  # Azzera il Blu
                
                # Creiamo una copia contigua in memoria per Pygame
                frame_contiguous = np.ascontiguousarray(frame)
                
                # Pygame leggerà il buffer come RGB puro
                frame_surface_base = pygame.image.frombuffer(
                    frame_contiguous.tobytes(), (camera_width, camera_height), "RGB"
                )
                
                if (camera_width != SCREEN_WIDTH) or (camera_height != SCREEN_HEIGHT):
                    camera_surface = pygame.transform.scale(frame_surface_base, (SCREEN_WIDTH, SCREEN_HEIGHT))
                else:
                    camera_surface = frame_surface_base
                screen.blit(camera_surface, (0, 0))
            except Exception as e:
                logging.error(f"Errore cattura frame camera: {e}")
                screen.fill(colors["bg"])
        else:
            screen.fill(colors["bg"])

        cx, cy = SCREEN_WIDTH // 2, SCREEN_HEIGHT // 2
        
        all_catalog = CELESTIAL_CATALOG + SATELLITES
        
        # Controllo di sicurezza sull'indice del target
        if state["target_index"] >= len(all_catalog):
            state["target_index"] = 0
            
        target_obj = all_catalog[state["target_index"]]
        projected_positions = {}

        for idx, obj in enumerate(all_catalog):
            if obj["alt"] < -5.0:
                continue

            x, y, visible, d_az, d_alt = project_az_alt(
                obj["az"], obj["alt"], current_yaw, current_pitch, cx, cy
            )
            
            is_current_target = (idx == state["target_index"])

            if visible:
                projected_positions[obj["name"]] = (x, y)
                mag = obj["mag"]
                radius = max(2, int(5 - mag))

                if is_current_target:
                    pygame.draw.circle(screen, colors["target"], (x, y), radius + 8, 2)
                    pygame.draw.rect(screen, colors["target"], (x - 12, y - 12, 24, 24), 1)
                    txt_col = colors["target"]
                
                elif obj["type"] == "satellite":
                    if state["sat_blink_toggle"]:
                        size = 4
                        pygame.draw.polygon(screen, colors["satellite"], [(x, y-size), (x+size, y), (x, y+size), (x-size, y)])
                    txt_col = colors["satellite"]
                    radius = 4 

                elif obj["type"] == "planet":
                    pygame.draw.circle(screen, colors["planet"], (x, y), radius + 2)
                    pygame.draw.circle(screen, colors["orange"], (x, y), radius + 2, 1)
                    txt_col = colors["planet"]

                elif obj["type"] == "deep_sky":
                    pygame.draw.circle(screen, colors["deep_sky"], (x, y), radius + 4, 1)
                    pygame.draw.circle(screen, colors["deep_sky"], (x, y), radius + 2, 1)
                    pygame.draw.circle(screen, colors["deep_sky"], (x, y), 1)
                    txt_col = colors["deep_sky"]

                else:
                    pygame.draw.circle(screen, colors["star"], (x, y), radius)
                    txt_col = colors["star"]

                label = font_small.render(obj["name"], True, txt_col)
                screen.blit(label, (x + radius + 6, y - 6))

        for star1, star2 in CONSTELLATION_LINES:
            if star1 in projected_positions and star2 in projected_positions:
                pygame.draw.line(screen, colors["constellation"], projected_positions[star1], projected_positions[star2], 1)

        for const_name, star_names in CONSTELLATION_GROUPS.items():
            points = [projected_positions[s] for s in star_names if s in projected_positions]
            if len(points) >= 2:
                avg_x = sum(p[0] for p in points) // len(points)
                avg_y = sum(p[1] for p in points) // len(points)
                
                const_lbl = font_const.render(const_name, True, colors["constellation_name"])
                screen.blit(const_lbl, (avg_x - const_lbl.get_width() // 2, avg_y + 15))

        _, _, target_visible, target_d_az, target_d_alt = project_az_alt(
            target_obj["az"], target_obj["alt"], current_yaw, current_pitch, cx, cy
        )
        
        if target_obj["alt"] < 0:
            warning_msg = font_hud.render("TARGET BELOW HORIZON", True, colors["warn"])
            screen.blit(warning_msg, (cx - warning_msg.get_width() // 2, cy + 40))
        elif not target_visible:
            draw_offscreen_arrow(screen, target_d_az, target_d_alt, cx, cy, colors["target"])

        draw_crosshair(screen, cx, cy, colors["hud"])
        draw_compass(screen, current_yaw, colors)
        draw_telemetry(
            screen, current_yaw, current_pitch, 
            current_lat, current_lon, gps_fix, target_obj, target_d_az, target_d_alt, cpu_temperature, colors
        )

        if state["calib_msg_frames"] > 0:
            msg_text = font_big.render(f"IMU ALIGNED TO: {target_obj['name'].upper()}", True, colors["target"])
            screen.blit(msg_text, (SCREEN_WIDTH // 2 - msg_text.get_width() // 2, SCREEN_HEIGHT - 120))
            state["calib_msg_frames"] -= 1

        pygame.display.flip()
        clock.tick(30)

except KeyboardInterrupt:
    logging.info("Interruzione manuale rilevata.")
finally:
    logging.info("Arresto sistema in corso...")
    if picam2:
        picam2.stop()
    if gps_serial:
        gps_serial.close()
    pygame.quit()
    sys.exit(0)
