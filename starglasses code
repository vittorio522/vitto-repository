/*
  SKYMAP REALISTICA su OLED (128x64 I2C) - Arduino Uno/Nano
  =========================================================

  Calcola la posizione reale (alt/azimuth) di ~30 stelle brillanti
  in base a data/ora/posizione (da GPS) e mostra solo quelle nel
  campo visivo verso cui è orientato il dispositivo.

  ORIENTAMENTO:
   - Altezza (tilt) letta dall'accelerometro -> stabile, nessuna deriva.
   - Direzione (azimuth/bussola) stimata integrando il giroscopio ->
     DERIVA nel tempo (non c'è magnetometro). Premi il pulsante di
     ricalibrazione mentre punti il dispositivo verso Nord per azzerare.

  HARDWARE:
   - OLED SSD1306/SH1106 128x64 - I2C (SDA=A4, SCL=A5)
   - GPS (es. NEO-6M) - SoftwareSerial su pin 4(RX)/3(TX), 9600 baud
   - MPU6050 - I2C (stesso bus, indirizzo 0x68, AD0 a GND)
   - Pulsante ricalibrazione Nord - pin 2 a GND (usa INPUT_PULLUP)

  LIBRERIE RICHIESTE (Library Manager):
   - Adafruit SSD1306
   - Adafruit GFX Library
   - TinyGPSPlus (di Mikal Hart)

  NOTA: la mappatura degli assi dell'accelerometro (pitch) dipende da
  come monti fisicamente l'MPU6050. Se l'inclinazione risulta invertita
  o sbagliata, prova a scambiare gli assi nella funzione readTiltPitch().
*/

#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>
//#include <SoftwareSerial.h>
//#include <TinyGPSPlus.h>
#include <math.h>

// ---------------- DISPLAY ----------------
#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64
#define OLED_RESET -1
#define SCREEN_ADDRESS 0x3C
Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, OLED_RESET);

double latitude = 45.4384;     // esempio
double longitude = 12.3271;

bool coordinatesSet = false;

void readCoordinatesFromSerial() {

  if (!Serial.available()) return;

  String line = Serial.readStringUntil('\n');
  line.trim();

  int comma = line.indexOf(',');

  if (comma == -1) {
    Serial.println("Formato: latitudine,longitudine");
    Serial.println("Esempio: 44.8354,11.6198");
    return;
  }

  latitude = line.substring(0, comma).toFloat();
  longitude = line.substring(comma + 1).toFloat();

  coordinatesSet = true;

  Serial.println("Coordinate aggiornate:");
  Serial.print("Lat = ");
  Serial.println(latitude, 6);
  Serial.print("Lon = ");
  Serial.println(longitude, 6);
}

