const int NUM_STARS = sizeof(catalog) / sizeof(StarData);

// ================= SETUP =================
void setup() {
  Serial.begin(9600);
  //gpsSerial.begin(9600);
  Wire.begin();

  pinMode(BUTTON_PIN, INPUT_PULLUP);

  if (!display.begin(SSD1306_SWITCHCAPVCC, SCREEN_ADDRESS)) {
    Serial.println("OLED non trovato!");
    for (;;);
  }
  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);

  initMPU();
  calibrateGyro();

  lastMicros = micros();
  Serial.println();
  Serial.println("Inserisci le coordinate nel formato:");
  Serial.println("45.4384,12.3271");
}

// ================= LOOP =================
void loop() {
  /* leggi GPS
  while (gpsSerial.available() > 0) {
    gps.encode(gpsSerial.read());
  }*/
  readCoordinatesFromSerial();

  // ricalibrazione Nord
  if (digitalRead(BUTTON_PIN) == LOW) {
    heading = 0.0;
  }

  updateOrientation();

  display.clearDisplay();

  if (coordinatesSet)  {
    double lat = latitude; 
    double lon = longitude;
    double jd = julianDate(2026, 7, 13,
                       21, 30, 0);
    double lst = localSiderealTime(jd, lon);

    float pitch = readTiltPitch();

    for (int i = 0; i < NUM_STARS; i++) {
      StarData s;
      memcpy_P(&s, &catalog[i], sizeof(StarData));

      float alt, az;
      computeAltAz(s.ra, s.dec, lat, lst, alt, az);

      if (alt < 0) continue; // sotto l'orizzonte

      float azDiff = normalizeDeg180(az - heading);
      float altDiff = alt - pitch;

      if (fabs(azDiff) > FOV_H / 2.0 || fabs(altDiff) > FOV_V / 2.0) continue;

      int x = SCREEN_WIDTH / 2 + (int)((azDiff / (FOV_H / 2.0)) * (SCREEN_WIDTH / 2.0));
      int y = SCREEN_HEIGHT / 2 - (int)((altDiff / (FOV_V / 2.0)) * (SCREEN_HEIGHT / 2.0));

      if (x < 0 || x >= SCREEN_WIDTH || y < 0 || y >= SCREEN_HEIGHT) continue;

      if (s.mag < 0.5) display.fillCircle(x, y, 2, SSD1306_WHITE);
      else if (s.mag < 1.5) display.fillCircle(x, y, 1, SSD1306_WHITE);
      else display.drawPixel(x, y, SSD1306_WHITE);
    }

    // overlay informativo (rimuovi se vuoi solo la grafica pulita)
    display.setCursor(0, 0);
    display.setTextSize(1);
    display.print("Az:");
    display.print((int)heading);
    display.print(" Alt:");
    display.print((int)pitch);
  } else {
    display.setCursor(0, 0);
    display.print("Inserisci dati");
    display.setCursor(0, 10);
    display.print("da seriale");
  }

  display.display();
  delay(150);
}

// ================= MPU6050 =================
void initMPU() {
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(0x6B); // PWR_MGMT_1
  Wire.write(0);
  Wire.endTransmission(true);
}

void readMPURaw(int16_t &ax, int16_t &ay, int16_t &az, int16_t &gx, int16_t &gy, int16_t &gz) {
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(0x3B);
  Wire.endTransmission(false);
  Wire.requestFrom(MPU_ADDR, 14, true);
  ax = Wire.read() << 8 | Wire.read();
  ay = Wire.read() << 8 | Wire.read();
  az = Wire.read() << 8 | Wire.read();
  Wire.read(); Wire.read(); // temperatura, ignorata
  gx = Wire.read() << 8 | Wire.read();
  gy = Wire.read() << 8 | Wire.read();
  gz = Wire.read() << 8 | Wire.read();
}

void calibrateGyro() {
  Serial.println("Calibrazione giroscopio: tieni fermo il dispositivo...");
  long sum = 0;
  int16_t ax, ay, az, gx, gy, gz;
  const int N = 200;
  for (int i = 0; i < N; i++) {
    readMPURaw(ax, ay, az, gx, gy, gz);
    sum += gz;
    delay(3);
  }
  gyroZOffset = sum / (float)N;
  Serial.println("Calibrazione completata.");
}

// Aggiorna heading (integrazione giroscopio) - CHIAMARE OGNI LOOP
void updateOrientation() {
  int16_t ax, ay, az, gx, gy, gz;
  readMPURaw(ax, ay, az, gx, gy, gz);

  unsigned long now = micros();
  float dt = (now - lastMicros) / 1000000.0;
  lastMicros = now;

  // sensibilita' default MPU6050 (+-250 deg/s): 131 LSB per deg/s
  float gzDps = (gz - gyroZOffset) / 131.0;
  heading += gzDps * dt;
  heading = normalizeDeg360(heading);
}

// Inclinazione (pitch) dall'accelerometro - stabile, nessuna deriva.
// NOTA: se il risultato è invertito o sbagliato rispetto al montaggio
// fisico, prova a scambiare ax/ay/az qui sotto.
float readTiltPitch() {
  int16_t ax, ay, az, gx, gy, gz;
  readMPURaw(ax, ay, az, gx, gy, gz);
  float pitch = atan2(-ax, sqrt((float)ay * ay + (float)az * az)) * 180.0 / PI;
  return pitch;
}

// ================= ASTRONOMIA =================
double julianDate(int year, int month, int day, int hour, int minute, int second) {
  double ut = hour + minute / 60.0 + second / 3600.0;
  double jd = 367.0 * year
              - floor(7.0 * (year + floor((month + 9.0) / 12.0)) / 4.0)
              + floor(275.0 * month / 9.0)
              + day + 1721013.5 + ut / 24.0;
  return jd;
}

double localSiderealTime(double jd, double lonDeg) {
  double T = (jd - 2451545.0) / 36525.0;
  double gmst = 280.46061837 + 360.98564736629 * (jd - 2451545.0)
                + 0.000387933 * T * T - (T * T * T) / 38710000.0;
  double lst = gmst + lonDeg;
  lst = fmod(lst, 360.0);
  if (lst < 0) lst += 360.0;
  return lst;
}

void computeAltAz(float raDeg, float decDeg, double latDeg, double lstDeg, float &altOut, float &azOut) {
  double H = lstDeg - raDeg; // hour angle in gradi
  H = fmod(H, 360.0);
  if (H < 0) H += 360.0;

  double Hrad = H * PI / 180.0;
  double decRad = decDeg * PI / 180.0;
  double latRad = latDeg * PI / 180.0;

  double sinAlt = sin(decRad) * sin(latRad) + cos(decRad) * cos(latRad) * cos(Hrad);
  double alt = asin(sinAlt);

  double cosA = (sin(decRad) - sin(alt) * sin(latRad)) / (cos(alt) * cos(latRad));
  // clamp per errori di arrotondamento
  if (cosA > 1.0) cosA = 1.0;
  if (cosA < -1.0) cosA = -1.0;
  double A = acos(cosA);

  double az;
  if (sin(Hrad) > 0) az = 360.0 - (A * 180.0 / PI);
  else az = A * 180.0 / PI;

  altOut = alt * 180.0 / PI;
  azOut = az;
}

float normalizeDeg360(float deg) {
  deg = fmod(deg, 360.0);
  if (deg < 0) deg += 360.0;
  return deg;
}

float normalizeDeg180(float deg) {
  deg = normalizeDeg360(deg);
  if (deg > 180.0) deg -= 360.0;
  return deg;
}
