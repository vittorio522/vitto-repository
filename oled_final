# DESKTOP PANEL RENDER
# ============================================================
def _status_led(x, y, ok, label):
    color = C_GREEN if ok else C_RED
    pygame.gfxdraw.filled_circle(window, x, y, 4, color)
    pygame.gfxdraw.aacircle(window, x, y, 4, color)
    window.blit(T(DESKTOP_FONT_SM, label, C_TEXT), (x + 10, y - 8))


def render_desktop_panel(tgt):
    window.fill(C_BG)

    # Side panel background
    panel_x = 600
    pygame.draw.rect(window, C_PANEL, (panel_x, 0, DESKTOP_W - panel_x, DESKTOP_H))
    pygame.draw.line(window, C_LINE, (panel_x, 0), (panel_x, DESKTOP_H), 2)

    # ---- OLED-style bezel around the sky view ----
    bezel_x, bezel_y = 40, 40
    pygame.draw.rect(window, (0, 0, 0), (bezel_x+5, bezel_y+5, SKY_W, SKY_H), border_radius=10)   # shadow
    pygame.draw.rect(window, (40, 40, 50), (bezel_x-10, bezel_y-10, SKY_W+20, SKY_H+20), border_radius=10)
    pygame.draw.rect(window, (0, 0, 0), (bezel_x, bezel_y, SKY_W, SKY_H), border_radius=4)

    render_desktop_sky(tgt)
    window.blit(sky_surf, (bezel_x, bezel_y))

    # ---- Right side panel ----
    y = 40
    window.blit(T(DESKTOP_FONT_TITLE, "STAR TRACKER", C_ACCENT), (panel_x + 20, y))
    y += 35
    window.blit(T(DESKTOP_FONT_MED, "OBSERVATORY CONTROL", C_TEXT), (panel_x + 20, y))
    y += 30

    # Hardware status LEDs
    _status_led(panel_x + 28,  y + 4, HAS_EPHEM,  "EPHEM")
    _status_led(panel_x + 118, y + 4, bno is not None, "IMU")
    _status_led(panel_x + 208, y + 4, HAS_OLED,   "OLED")
    _status_led(panel_x + 298, y + 4, HAS_GPIO,   "GPIO")
    y += 26
    pygame.draw.line(window, C_LINE, (panel_x + 20, y), (DESKTOP_W - 20, y))
    y += 15

    # Telemetry
    window.blit(T(DESKTOP_FONT_MED, "TELEMETRY", C_ACCENT), (panel_x + 20, y))
    y += 25
    utc_now = datetime.datetime.now(datetime.timezone.utc)
    info_lines = [
        f"YAW:   {int(state['current_yaw']) % 360:03d} deg",
        f"PITCH: {int(state['current_pitch']):+03d} deg",
        f"ROLL:  {int(state['current_roll']):+02d} deg",
        f"LOC:   {LAT}, {LON}",
        f"UTC:   {utc_now.strftime('%H:%M:%S')}",
    ]
    for line in info_lines:
        window.blit(T(DESKTOP_FONT_SM, line, C_TEXT), (panel_x + 30, y))
        y += 20
    y += 14

    # Target info
    if tgt:
        window.blit(T(DESKTOP_FONT_MED, f"TARGET: {tgt.short}", C_ACCENT), (panel_x + 20, y))
        y += 25
        tgt_lines = [
            f"Name:  {tgt.name}",
            f"Type:  {tgt.kind.upper()} ({tgt.sub})",
            f"Cons:  {tgt.constellation}",
            f"Mag:   {tgt.mag:+.2f}",
            f"Dist:  {tgt.distance}",
        ]
        for line in tgt_lines:
            window.blit(T(DESKTOP_FONT_SM, line, C_TEXT), (panel_x + 30, y))
            y += 20

        if tgt.name == "Moon":
            y += 8
            window.blit(T(DESKTOP_FONT_MED, f"MOON PHASE: {tgt.phase:.1f}%", C_RED), (panel_x + 20, y))
            y += 25
            phase_desc = "Waxing" if tgt.is_waxing else "Waning"
            window.blit(T(DESKTOP_FONT_SM, f"Status: {phase_desc}", C_TEXT), (panel_x + 30, y))
            y += 20

        y += 8
        pygame.draw.line(window, C_LINE, (panel_x + 20, y), (DESKTOP_W - 20, y))
        y += 10
        for line in wrap_text(tgt.description, DESKTOP_FONT_SM, DESKTOP_W - panel_x - 40):
            window.blit(T(DESKTOP_FONT_SM, line, C_DIM), (panel_x + 20, y))
            y += 20

    # ---- Bottom left: controls + live OLED preview ----
    ctrl_x = 40
    ctrl_y = DESKTOP_H - 160
    window.blit(T(DESKTOP_FONT_MED, "CONTROLS", C_ACCENT), (ctrl_x, ctrl_y))
    cy2 = ctrl_y + 25
    for line in ("[ESC] Exit Program",
                 "[SPACE] Next Target",
                 "[I] Toggle Info Sheet",
                 "[C] Calibrate IMU",
                 "[WASD] Pan View (Sim)",
                 "[QE] Roll View (Sim)"):
        window.blit(T(DESKTOP_FONT_SM, line, C_TEXT), (ctrl_x + 10, cy2))
        cy2 += 20

    # Live preview of what the physical 128x64 OLED is showing
    prev_x, prev_y = 330, DESKTOP_H - 160
    prev_w, prev_h = 192, 96                       # 1.5x scale
    window.blit(T(DESKTOP_FONT_MED, "OLED 128x64", C_ACCENT), (prev_x, prev_y))
    frame_r = pygame.Rect(prev_x - 4, prev_y + 22, prev_w + 8, prev_h + 8)
    pygame.draw.rect(window, (40, 40, 50), frame_r, border_radius=6)
    window.blit(pygame.transform.scale(screen, (prev_w, prev_h)),
                (prev_x, prev_y + 26))


# ============================================================
# MAIN LOOP
# ============================================================
clock = pygame.time.Clock()

print("=== Star Tracker HUD ===")
print("Controls (click on the window to activate them):")
print(" ESC    : Exit program")
print(" SPACE  : Next target")
print(" I      : Toggle Info Page")
print(" C      : Calibrate")
print(" L      : Toggle labels")
print(" N      : Toggle DSO (Nebulae/Galaxies)")
print(" O      : Toggle constellations")
print(" UP/DN  : Magnitude filter")
if not bno:
    print(" WASD   : Move view (PC simulation)")
    print(" Q/E    : Rotate view (PC simulation)")

try:
    while True:
        now = time.time()

        for ev in pygame.event.get():
            if ev.type == pygame.QUIT:
                pygame.quit(); sys.exit()
            if ev.type == pygame.KEYDOWN:
                if ev.key == pygame.K_ESCAPE:
                    pygame.quit(); sys.exit()
                elif ev.key == pygame.K_SPACE:
                    next_target()
                elif ev.key == pygame.K_i:
                    state["show_info"] = not state["show_info"]
                    show_message(f"INFO: {'ON' if state['show_info'] else 'OFF'}")
                elif ev.key == pygame.K_c:
                    do_calibrate()
                elif ev.key == pygame.K_l:
                    state["show_label"] = not state["show_label"]
                    show_message(f"LABELS: {'ON' if state['show_label'] else 'OFF'}")
                elif ev.key == pygame.K_n:
                    state["show_dso"] = not state["show_dso"]
                    show_message(f"DSO: {'ON' if state['show_dso'] else 'OFF'}")
                elif ev.key == pygame.K_o:
                    state["show_const"] = not state["show_const"]
                    show_message(f"CONST: {'ON' if state['show_const'] else 'OFF'}")
                elif ev.key == pygame.K_UP:
                    state["filter_mag"] = min(8.0, state["filter_mag"] + 0.5)
                    show_message(f"MAG <= {state['filter_mag']:.1f}")
                elif ev.key == pygame.K_DOWN:
                    state["filter_mag"] = max(1.0, state["filter_mag"] - 0.5)
                    show_message(f"MAG <= {state['filter_mag']:.1f}")

        # ---- IMU / Desktop simulation controls ----
        if bno:
            try:
                e = bno.euler
                if e is not None and e[0] is not None:
                    state["raw_yaw"]       = e[0]
                    state["current_yaw"]   = (state["raw_yaw"] + state["yaw_offset"]) % 360
                    state["current_pitch"] = (e[2] or 0.0) + state["pitch_offset"]
                    state["current_roll"]  = (e[1] or 0.0)
            except Exception:
                pass
        else:
            keys = pygame.key.get_pressed()
            if keys[pygame.K_a]: state["current_yaw"] = (state["current_yaw"] - 1.5) % 360
            if keys[pygame.K_d]: state["current_yaw"] = (state["current_yaw"] + 1.5) % 360
            if keys[pygame.K_w]: state["current_pitch"] = min(90, state["current_pitch"] + 1.0)
            if keys[pygame.K_s]: state["current_pitch"] = max(-90, state["current_pitch"] - 1.0)
            if keys[pygame.K_q]: state["current_roll"] = max(-90, state["current_roll"] - 1.0)
            if keys[pygame.K_e]: state["current_roll"] = min(90, state["current_roll"] + 1.0)

        # ---- Astronomy refresh ----
        if now - state["last_astro"] > ASTRO_REFRESH:
            update_positions()
            state["last_astro"] = now

        # ---- UI timers: advanced exactly once per frame ----
        if state["calib_timer"] > 0: state["calib_timer"] -= 1
        if state["msg_timer"]  > 0: state["msg_timer"]  -= 1
        state["blink"] = (state["blink"] + 1) % 60

        # ---- Render OLED ----
        render_oled()

        # Push to physical OLED
        if HAS_OLED:
            raw = pygame.image.tobytes(screen, "RGB")
            pil_img = Image.frombytes("RGB", (SCREEN_W, SCREEN_H), raw).convert("L")
            pil_img = pil_img.point(lambda p: 255 if p > 80 else 0).convert("1")
            oled.display(pil_img)

        # ---- Render Desktop Panel ----
        tgt = CATALOG[state["target_index"]] if CATALOG else None
        render_desktop_panel(tgt)
        pygame.display.flip()

        clock.tick(FPS)

except KeyboardInterrupt:
    pass
finally:
    if HAS_OLED: oled.clear()
    pygame.quit()
    sys.exit(0)
