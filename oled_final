# RENDER CACHES (performance)
# ============================================================
_TEXT_CACHE: Dict[tuple, pygame.Surface] = {}

def T(font, text, color, aa=True):
    """Cached font.render - avoids re-rendering identical strings each frame."""
    key = (id(font), text, color, aa)
    surf = _TEXT_CACHE.get(key)
    if surf is None:
        if len(_TEXT_CACHE) > 512:          # keep memory bounded
            _TEXT_CACHE.clear()
        surf = font.render(text, aa, color)
        _TEXT_CACHE[key] = surf
    return surf


_MOON_CACHE: Dict[tuple, pygame.Surface] = {}

def moon_sprite(r, phase, waxing, lit, dark=None):
    """Cached moon phase sprite. Blitting a sprite (instead of per-pixel
    set_at) is both much faster and automatically clipped at screen edges."""
    key = (r, int(round(phase)), bool(waxing), lit, dark)
    surf = _MOON_CACHE.get(key)
    if surf is not None:
        return surf

    size = 2 * r + 1
    surf = pygame.Surface((size, size), pygame.SRCALPHA)
    b = r * (1.0 - phase / 50.0)
    for dx in range(-r, r + 1):
        for dy in range(-r, r + 1):
            if dx * dx + dy * dy > r * r:
                continue
            if phase <= 0:
                is_lit = False
            elif phase >= 100:
                is_lit = True
            else:
                x_term = b * math.sqrt(max(0.0, 1 - (dy * dy) / (r * r)))
                if waxing:
                    is_lit = (dx > -x_term) if phase < 50 else (dx > x_term)
                else:
                    is_lit = (dx < x_term) if phase < 50 else (dx < -x_term)
            if is_lit:
                surf.set_at((dx + r, dy + r), lit)
            elif dark is not None:
                surf.set_at((dx + r, dy + r), dark)
    _MOON_CACHE[key] = surf
    return surf


_GLOW_CACHE: Dict[tuple, pygame.Surface] = {}

def glow_sprite(radius, color):
    """Soft radial glow for bright stars (desktop only)."""
    key = (radius, color)
    surf = _GLOW_CACHE.get(key)
    if surf is not None:
        return surf
    size = radius * 2 + 1
    surf = pygame.Surface((size, size), pygame.SRCALPHA)
    for rr in range(radius, 0, -1):
        alpha = int(70 * (1 - rr / (radius + 1)) ** 2) + 8
        pygame.gfxdraw.filled_circle(surf, radius, radius, rr,
                                     (color[0], color[1], color[2], alpha))
    _GLOW_CACHE[key] = surf
    return surf


def _make_sky_gradient(w, h):
    """Static vertical gradient: deep space at top, faint airglow at horizon."""
    s = pygame.Surface((w, h))
    for y in range(h):
        t = y / max(1, h - 1)
        s.fill((int(5 + 8 * t), int(6 + 10 * t), int(14 + 18 * t)),
               (0, y, w, 1))
    return s

