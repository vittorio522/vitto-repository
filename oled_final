def _pick_font(size, bold=False):
    candidates = ["consolas", "dejavusansmono", "liberationmono",
                  "couriernew", "courier", "monospace"]
    for name in candidates:
        try:
            f = pygame.font.SysFont(name, size, bold=bold)
            if f.render("Az0123", False, (255, 255, 255)).get_width() > 0:
                return f
        except Exception:
            continue
    return pygame.font.Font(None, size + 2)

