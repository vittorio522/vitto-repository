        v_color = C_GREEN if tgt.visible else C_RED
        info_text = f"{tgt.name}  |  Alt: {tgt.alt:+04.1f}\u00b0  Az: {tgt.az:03.0f}\u00b0  |  {v_flag}"
        sky_surf.blit(T(DESKTOP_FONT_MED, info_text, v_color), (10, view_bot + 12))
    mode_lbl = T(DESKTOP_FONT_MED, f"[{state['mode']}]", C_ACCENT)
    sky_surf.blit(mode_lbl, (SKY_W - mode_lbl.get_width() - 10, view_bot + 12))
    mag_lbl = T(DESKTOP_FONT_MED, f"Mag: {state['filter_mag']:.1f}", (255, 255, 255))
    sky_surf.blit(mag_lbl, (SKY_W // 2 - mag_lbl.get_width() // 2, view_bot + 12))

    # 9. Calibration banner
    if state["calib_timer"] > 0:
        msg = T(DESKTOP_FONT_TITLE, "CALIBRATED", C_GREEN)
        bx = cx - msg.get_width() // 2
        by = cy - msg.get_height() // 2
        plate = pygame.Rect(bx - 15, by - 10, msg.get_width() + 30, msg.get_height() + 20)
        pygame.draw.rect(sky_surf, (0, 20, 0), plate)
        pygame.draw.rect(sky_surf, C_GREEN, plate, 2)
        sky_surf.blit(msg, (bx, by))

    # 10. On-screen messages
    if state["msg_timer"] > 0:
        msg = T(DESKTOP_FONT_TITLE, state["msg_text"], (255, 255, 255))
        bx = cx - msg.get_width() // 2
        by = cy - msg.get_height() // 2
        plate = pygame.Rect(bx - 15, by - 10, msg.get_width() + 30, msg.get_height() + 20)
        pygame.draw.rect(sky_surf, (20, 20, 30), plate)
        pygame.draw.rect(sky_surf, (200, 200, 200), plate, 2)
        sky_surf.blit(msg, (bx, by))


