# RENDER OLED
# ============================================================
def render_oled():
    screen.fill(BLACK)
    cx, cy = SCREEN_W // 2, SCREEN_H // 2
    view_top = TOP_H
    view_bot = SCREEN_H - BOT_H
    tgt = CATALOG[state["target_index"]] if CATALOG else None

    if state["show_info"] and tgt:
        screen.fill(BLACK)
        screen.blit(T(FONT_BIG, tgt.name, WHITE, aa=False), (2, 2))
        pygame.draw.line(screen, WHITE, (0, 16), (SCREEN_W, 16))
        y = 20
        screen.blit(T(FONT_HUD, f"Type: {tgt.kind.upper()} ({tgt.sub})", WHITE, aa=False), (2, y)); y += 10
        screen.blit(T(FONT_HUD, f"Cons: {tgt.constellation}", WHITE, aa=False), (2, y)); y += 10
        screen.blit(T(FONT_HUD, f"Mag:  {tgt.mag:+.1f}", WHITE, aa=False), (2, y)); y += 10
        screen.blit(T(FONT_HUD, f"Dist: {tgt.distance}", WHITE, aa=False), (2, y)); y += 10
        if tgt.name == "Moon":
            screen.blit(T(FONT_HUD, f"Phse:{tgt.phase:.1f}%", WHITE, aa=False), (2, y)); y += 10
        else:
            screen.blit(T(FONT_HUD, f"Alt:  {tgt.alt:+04.1f}", WHITE, aa=False), (2, y)); y += 10
        pygame.draw.line(screen, WHITE, (0, y), (SCREEN_W, y)); y += 2
        for line in wrap_text(tgt.description, FONT_TINY, SCREEN_W - 4):
            screen.blit(T(FONT_TINY, line, WHITE, aa=False), (2, y))
            y += 10
        return

    # 0. Horizon line (alt = 0) - dashed, only inside the sky viewport
    hy = int(horizon_y(SCREEN_H))
    if view_top + 2 < hy < view_bot - 2:
        dashed_line(screen, (0, hy), (SCREEN_W, hy), dash=3, gap=3)

    # 1. Compass ticks
    for deg, lbl in [(0, "N"), (90, "E"), (180, "S"), (270, "W")]:
        dx = ((deg - state["current_yaw"] + 180) % 360) - 180
        if abs(dx) < FOV_H_DEG * 0.6:
            x = int(cx + dx * PX_PER_DEG_X)
            pygame.draw.line(screen, WHITE, (x, view_top + 1), (x, view_top + 4))
            blit_text_with_bg(screen, lbl, FONT_TINY, x, view_top + 5, pad_x=1, pad_y=0, align="center")

    # 2. Corner brackets
    draw_corner_brackets()

    # 3. Constellation lines
    if state["show_const"]:
        for a, b in CONSTELLATION_LINES:
            oa = BY_NAME.get(a); ob = BY_NAME.get(b)
            if not oa or not ob: continue
            if oa.alt < -2 or ob.alt < -2: continue
            x1, y1 = project(oa.az, oa.alt)
            x2, y2 = project(ob.az, ob.alt)
            if not (in_view(x1, y1, SCREEN_W, SCREEN_H, 60) or in_view(x2, y2, SCREEN_W, SCREEN_H, 60)):
                continue
            dashed_line(screen, (x1, y1), (x2, y2), dash=2, gap=1)

    # 4. Celestial objects
    for idx, o in enumerate(CATALOG):
        if o.kind == "dso" and not state["show_dso"]: continue
        if o.alt < -1: continue
        if o.mag > state["filter_mag"] and o.name not in ("Sun", "Moon"): continue
        x, y = project(o.az, o.alt)
        if not in_view(x, y, SCREEN_W, SCREEN_H): continue
        ix, iy = int(x), int(y)
        is_target = (idx == state["target_index"])

        if o.name == "Sun":
            pygame.draw.circle(screen, WHITE, (ix, iy), 4)
            pygame.draw.line(screen, WHITE, (ix-6, iy), (ix-4, iy))
            pygame.draw.line(screen, WHITE, (ix+4, iy), (ix+6, iy))
            pygame.draw.line(screen, WHITE, (ix, iy-6), (ix, iy-4))
            pygame.draw.line(screen, WHITE, (ix, iy+4), (ix, iy+6))
        elif o.name == "Moon":
            draw_moon(screen, ix, iy, o.phase, o.is_waxing)
        elif o.kind == "dso":
            draw_dashed_circle(screen, ix, iy, 3)
        elif o.kind == "planet":
            draw_star(screen, ix, iy, 0.0)
            draw_dashed_circle(screen, ix, iy, 3)
        else:
            draw_star(screen, ix, iy, o.mag)

        if is_target and (state["blink"] // 8) % 2 == 0:
            pygame.draw.rect(screen, WHITE, (ix - 5, iy - 5, 11, 11), 1)
            pygame.draw.line(screen, WHITE, (ix - 7, iy - 7), (ix - 5, iy - 5))
            pygame.draw.line(screen, WHITE, (ix + 5, iy - 7), (ix + 7, iy - 5))
            pygame.draw.line(screen, WHITE, (ix - 7, iy + 7), (ix - 5, iy + 5))
            pygame.draw.line(screen, WHITE, (ix + 5, iy + 7), (ix + 7, iy + 5))

        if state["show_label"] and (o.kind != "star" or o.mag < 1.5 or is_target):
            lbl = T(FONT_TINY, o.short, WHITE, aa=False)
            lw, lh = lbl.get_width(), lbl.get_height()
            lx = ix + 4
            ly = iy - lh // 2
            if lx + lw > SCREEN_W - 1: lx = ix - lw - 4
            if ly < view_top + 1: ly = view_top + 1
            if ly + lh > view_bot - 1: ly = view_bot - 1 - lh
            plate = pygame.Rect(lx - 1, ly, lw + 2, lh)
            pygame.draw.rect(screen, BLACK, plate)
            screen.blit(lbl, (lx, ly))

    # 5. Off-screen target arrow
    if tgt and tgt.alt >= -1:
        tx, ty = project(tgt.az, tgt.alt)
        if not (0 <= tx < SCREEN_W and view_top <= ty < view_bot):
            draw_offscreen_arrow(tx, ty)

    # 6. Center crosshair
    pygame.draw.line(screen, WHITE, (cx - 5, cy), (cx - 2, cy))
    pygame.draw.line(screen, WHITE, (cx + 2, cy), (cx + 5, cy))
    pygame.draw.line(screen, WHITE, (cx, cy - 5), (cx, cy - 2))
    pygame.draw.line(screen, WHITE, (cx, cy + 2), (cx, cy + 5))

    # 7. Top HUD bar
    pygame.draw.rect(screen, BLACK, (0, 0, SCREEN_W, TOP_H))
    pygame.draw.line(screen, WHITE, (0, TOP_H), (SCREEN_W, TOP_H))
    hud_l = T(FONT_HUD, f"Y{int(state['current_yaw'])%360:03d} P{int(state['current_pitch']):+03d} R{int(state['current_roll']):+02d}", WHITE, aa=False)
    screen.blit(hud_l, (1, 2))
    if tgt:
        hud_r = T(FONT_HUD, tgt.short, WHITE, aa=False)
        screen.blit(hud_r, (SCREEN_W - hud_r.get_width() - 1, 2))

    # 8. Bottom HUD bar
    pygame.draw.line(screen, WHITE, (0, view_bot), (SCREEN_W, view_bot))
    pygame.draw.rect(screen, BLACK, (0, view_bot + 1, SCREEN_W, BOT_H - 1))
    if tgt:
        v_flag = "OK" if tgt.visible else "--"
        info = f"{tgt.short} {tgt.alt:+04.0f}/{tgt.az:03.0f} {v_flag}"
        screen.blit(T(FONT_HUD, info, WHITE, aa=False), (1, view_bot + 2))
    mode_lbl = T(FONT_HUD, state["mode"], WHITE, aa=False)
    screen.blit(mode_lbl, (SCREEN_W - mode_lbl.get_width() - 1, view_bot + 2))
    mag_lbl = T(FONT_HUD, f"m{state['filter_mag']:.1f}", WHITE, aa=False)
    screen.blit(mag_lbl, (SCREEN_W // 2 - mag_lbl.get_width() // 2, view_bot + 2))

    # 9. Calibration banner
    if state["calib_timer"] > 0:
        msg = T(FONT_BIG, "CALIBRATED", WHITE, aa=False)
        bx = cx - msg.get_width() // 2
        by = cy - msg.get_height() // 2
        plate = pygame.Rect(bx - 4, by - 2, msg.get_width() + 8, msg.get_height() + 4)
        pygame.draw.rect(screen, BLACK, plate)
        pygame.draw.rect(screen, WHITE, plate, 1)
        screen.blit(msg, (bx, by))

    # 10. On-screen messages
    if state["msg_timer"] > 0:
        msg = T(FONT_BIG, state["msg_text"], WHITE, aa=False)
        bx = cx - msg.get_width() // 2
        by = cy - msg.get_height() // 2
        plate = pygame.Rect(bx - 4, by - 2, msg.get_width() + 8, msg.get_height() + 4)
        pygame.draw.rect(screen, BLACK, plate)
        pygame.draw.rect(screen, WHITE, plate, 1)
        screen.blit(msg, (bx, by))

    # NOTE: blink / calib_timer / msg_timer are now advanced ONCE per frame
    # in the main loop (they used to be decremented in both renderers,
    # halving every message's duration).


