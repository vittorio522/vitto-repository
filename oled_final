    pygame.draw.line(screen, WHITE, (SCREEN_W - 1, yt), (SCREEN_W - 1, yt + bl))
    pygame.draw.line(screen, WHITE, (0, yb), (bl, yb))
    pygame.draw.line(screen, WHITE, (0, yb), (0, yb - bl))
    pygame.draw.line(screen, WHITE, (SCREEN_W - 1, yb), (SCREEN_W - 1 - bl, yb))
    pygame.draw.line(screen, WHITE, (SCREEN_W - 1, yb), (SCREEN_W - 1, yb - bl))

def draw_offscreen_arrow(tx, ty):
    cx, cy = SCREEN_W // 2, SCREEN_H // 2
    dx, dy = tx - cx, ty - cy
    ang = math.atan2(dy, dx)
    rx = SCREEN_W / 2 - 12
    ry = SCREEN_H / 2 - 14
    sx = abs(math.cos(ang)) or 1e-6
    sy = abs(math.sin(ang)) or 1e-6
    scale = min(rx / sx, ry / sy)
    ix = int(cx + math.cos(ang) * scale)
    iy = int(cy + math.sin(ang) * scale)
    head = 4
    # shaft (new: makes the arrow read as an arrow, not just a chevron)
    pygame.draw.line(screen, WHITE,
                     (int(ix - math.cos(ang) * 6), int(iy - math.sin(ang) * 6)),
                     (ix, iy))
    a1 = ang + math.pi - 0.5
    a2 = ang + math.pi + 0.5
    pygame.draw.line(screen, WHITE, (ix, iy),
                     (int(ix + math.cos(a1) * head), int(iy + math.sin(a1) * head)))
    pygame.draw.line(screen, WHITE, (ix, iy),
                     (int(ix + math.cos(a2) * head), int(iy + math.sin(a2) * head)))

def blit_text_with_bg(surf, text, font, x, y, pad_x=1, pad_y=0, align="left"):
    label = T(font, text, WHITE, aa=False)
    lw, lh = label.get_width(), label.get_height()
    if align == "right":
        rx = x - lw
    elif align == "center":
        rx = x - lw // 2
    else:
        rx = x
    ry = y
    plate = pygame.Rect(rx - pad_x, ry - pad_y, lw + 2 * pad_x, lh + 2 * pad_y)
    if plate.left < 0: plate.left = 0
    if plate.right > SCREEN_W: plate.right = SCREEN_W
    if plate.top < 0: plate.top = 0
    if plate.bottom > SCREEN_H: plate.bottom = SCREEN_H
    pygame.draw.rect(surf, BLACK, plate)
    surf.blit(label, (rx, ry))
    return plate

def wrap_text(text, font, max_width):
    words = text.split()
    lines = []
    current_line = ""
    for word in words:
        test_line = current_line + (" " if current_line else "") + word
        if font.size(test_line)[0] <= max_width:
            current_line = test_line
        else:
            if current_line:
                lines.append(current_line)
            current_line = word
    if current_line:
        lines.append(current_line)
    return lines


