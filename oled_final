# PROJECTION
# ============================================================
def project(az, alt):
    d_az  = ((az - state["current_yaw"] + 180) % 360) - 180
    d_alt = alt - state["current_pitch"]
    x = SCREEN_W * 0.5 + d_az  * PX_PER_DEG_X
    y = SCREEN_H * 0.5 - d_alt * PX_PER_DEG_Y
    return x, y

def project_native(az, alt, w, h):
    d_az  = ((az - state["current_yaw"] + 180) % 360) - 180
    d_alt = alt - state["current_pitch"]
    x = w * 0.5 + d_az * (PX_PER_DEG_X * (w / SCREEN_W))
    y = h * 0.5 - d_alt * (PX_PER_DEG_Y * (h / SCREEN_H))
    return x, y

def in_view(x, y, w, h, m=4):
    return -m <= x <= w + m and -m <= y <= h + m

def horizon_y(h_px, scale=1.0):
    """Screen y of the true horizon (alt = 0) for the current pitch."""
    return h_px * 0.5 + state["current_pitch"] * PX_PER_DEG_Y * scale


