# ASTRONOMICAL UPDATE
# ============================================================
def update_positions():
    if not HAS_EPHEM: return
    obs = ephem.Observer()
    obs.lat, obs.lon = str(LAT), str(LON)
    obs.date = datetime.datetime.now(datetime.timezone.utc)
    obs.horizon = "-1:00"
    sun = ephem.Sun()
    sun.compute(obs)
    sun_lon = ephem.Ecliptic(sun).lon

    for o in CATALOG:
        try:
            o.body.compute(obs)
            o.az  = math.degrees(o.body.az)
            o.alt = math.degrees(o.body.alt)
            o.visible = o.alt > -1

            if o.name == "Moon":
                o.phase = o.body.phase
                moon_lon = ephem.Ecliptic(o.body).lon
                o.is_waxing = moon_lon > sun_lon
        except Exception:
            o.visible = False


