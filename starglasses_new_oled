# ASTRO UPDATE
# ============================================================
def update_positions():
    if not HAS_EPHEM: return
    obs = ephem.Observer()
    obs.lat, obs.lon = str(LAT), str(LON)
    obs.date = datetime.datetime.now(datetime.timezone.utc)
    obs.horizon = "-1:00"      # atmospheric refraction
    for o in CATALOG:
        try:
            o.body.compute(obs)
            o.az  = math.degrees(o.body.az)
            o.alt = math.degrees(o.body.alt)
            o.visible = o.alt > -1
        except Exception:
            o.visible = False


# ============================================================
# PROJECTION
# ============================================================
def project(az, alt):
    d_az  = ((az - state["current_yaw"] + 180) % 360) - 180
    d_alt = alt - state["current_pitch"]
    x = SCREEN_W * 0.5 + d_az  * PX_PER_DEG_X
    y = SCREEN_H * 0.5 - d_alt * PX_PER_DEG_Y
    return x, y

def in_view(x, y, m=4):
    return -m <= x <= SCREEN_W + m and -m <= y <= SCREEN_H + m


# ============================================================
# 1-BIT DRAW HELPERS
# ============================================================
WHITE = (255, 255, 255)
BLACK = (0, 0, 0)

def _px(surf, x, y):
    if 0 <= x < SCREEN_W and 0 <= y < SCREEN_H:
        surf.set_at((x, y), WHITE)

def dashed_line(surf, p1, p2, dash=2, gap=1):
    x1, y1 = p1; x2, y2 = p2
    dx, dy = x2 - x1, y2 - y1
    dist = math.hypot(dx, dy)
    if dist < 1: return
    ux, uy = dx / dist, dy / dist
    d = 0
    while d < dist:
        d_end = min(d + dash, dist)
        sx, sy = x1 + ux * d, y1 + uy * d
        ex, ey = x1 + ux * d_end, y1 + uy * d_end
        pygame.draw.line(surf, WHITE, (sx, sy), (ex, ey))
        d += dash + gap

def draw_dashed_circle(surf, cx, cy, r, segs=8):
    for i in range(segs):
        if i % 2 == 0: continue
        a1 = (i / segs) * 2 * math.pi
        a2 = ((i + 1) / segs) * 2 * math.pi
        x1 = cx + math.cos(a1) * r; y1 = cy + math.sin(a1) * r
        x2 = cx + math.cos(a2) * r; y2 = cy + math.sin(a2) * r
        pygame.draw.line(surf, WHITE, (x1, y1), (x2, y2))

def draw_star(surf, x, y, mag):
    """Magnitude-aware star rendering ottimizzato per 128x64."""
    if mag < 0:
        # Stellata (plus shape)
        for d in range(-2, 3):
            _px(surf, x + d, y); _px(surf, x, y + d)
    elif mag < 1.5:
        # 2x2 pixel
        _px(surf, x, y); _px(surf, x+1, y)
        _px(surf, x, y+1); _px(surf, x+1, y+1)
    elif mag < 2.8:
        _px(surf, x, y)
    else:
        _px(surf, x, y)

def draw_corner_brackets():
    bl = 6
    yt, yb = TOP_H, SCREEN_H - BOT_H - 1
    pygame.draw.line(screen, WHITE, (0, yt), (bl, yt))
    pygame.draw.line(screen, WHITE, (0, yt), (0, yt + bl))
    pygame.draw.line(screen, WHITE, (SCREEN_W - 1, yt), (SCREEN_W - 1 - bl, yt))
    pygame.draw.line(screen, WHITE, (SCREEN_W - 1, yt), (SCREEN_W - 1, yt + bl))
    pygame.draw.line(screen, WHITE, (0, yb), (bl, yb))
    pygame.draw.line(screen, WHITE, (0, yb), (0, yb - bl))
    pygame.draw.line(screen, WHITE, (SCREEN_W - 1, yb), (SCREEN_W - 1 - bl, yb))
    pygame.draw.line(screen, WHITE, (SCREEN_W - 1, yb), (SCREEN_W - 1, yb - bl))

def draw_offscreen_arrow(tx, ty):
    cx, cy = SCREEN_W // 2, SCREEN_H // 2
    dx, dy = tx - cx, ty - cy
    ang = math.atan2(dy, dx)
    rx = SCREEN_W / 2 - 12
    ry = SCREEN_H / 2 - 14
    sx = abs(math.cos(ang)) or 1e-6
    sy = abs(math.sin(ang)) or 1e-6
    scale = min(rx / sx, ry / sy)
    ix = int(cx + math.cos(ang) * scale)
    iy = int(cy + math.sin(ang) * scale)
    head = 4
    a1 = ang + math.pi - 0.5
    a2 = ang + math.pi + 0.5
    pygame.draw.line(screen, WHITE, (ix, iy),
                     (int(ix + math.cos(a1) * head), int(iy + math.sin(a1) * head)))
    pygame.draw.line(screen, WHITE, (ix, iy),
                     (int(ix + math.cos(a2) * head), int(iy + math.sin(a2) * head)))


# ============================================================
# RENDER
# ============================================================
def render():
    screen.fill(BLACK)
    cx, cy = SCREEN_W // 2, SCREEN_H // 2
    view_top = TOP_H
    view_bot = SCREEN_H - BOT_H

    # 1. Compass ticks
    for deg, lbl in [(0, "N"), (90, "E"), (180, "S"), (270, "W")]:
        dx = ((deg - state["current_yaw"] + 180) % 360) - 180
        if abs(dx) < FOV_H_DEG * 0.6:
            x = int(cx + dx * PX_PER_DEG_X)
            pygame.draw.line(screen, WHITE, (x, view_top + 1), (x, view_top + 4))
            t = FONT_TINY.render(lbl, False, WHITE)
            screen.blit(t, (x - t.get_width() // 2, view_top + 5))

    # 2. Corner brackets
    draw_corner_brackets()

    # 3. Constellation lines
    if state["show_const"]:
        for a, b in CONSTELLATION_LINES:
            oa = BY_NAME.get(a); ob = BY_NAME.get(b)
            if not oa or not ob: continue
            if oa.alt < -2 or ob.alt < -2: continue
            x1, y1 = project(oa.az, oa.alt)
            x2, y2 = project(ob.az, ob.alt)
            if not (in_view(x1, y1, 60) or in_view(x2, y2, 60)):
                continue
            dashed_line(screen, (x1, y1), (x2, y2), dash=2, gap=1)

    # 4. Celestial objects
    for idx, o in enumerate(CATALOG):
        if o.kind == "dso" and not state["show_dso"]: continue
        if o.alt < -1: continue
        if o.mag > state["filter_mag"]: continue
        x, y = project(o.az, o.alt)
        if not in_view(x, y): continue
        ix, iy = int(x), int(y)
        is_target = (idx == state["target_index"])

        if o.kind == "dso":
            draw_dashed_circle(screen, ix, iy, 3)
        elif o.kind == "planet":
            draw_star(screen, ix, iy, 0.0)
            draw_dashed_circle(screen, ix, iy, 3)
        else:
            draw_star(screen, ix, iy, o.mag)

        # Target reticle (blinking)
        if is_target and (state["blink"] // 8) % 2 == 0:
            pygame.draw.rect(screen, WHITE, (ix - 5, iy - 5, 11, 11), 1)
            pygame.draw.line(screen, WHITE, (ix - 7, iy - 7), (ix - 5, iy - 5))
            pygame.draw.line(screen, WHITE, (ix + 5, iy - 7), (ix + 7, iy - 5))
            pygame.draw.line(screen, WHITE, (ix - 7, iy + 7), (ix - 5, iy + 5))
            pygame.draw.line(screen, WHITE, (ix + 5, iy + 7), (ix + 7, iy + 5))

        # Labels
        if state["show_label"] and (o.kind != "star" or o.mag < 1.5 or is_target):
            lbl = FONT_TINY.render(o.short, False, WHITE)
            lx, ly = ix + 4, iy - 4
            if lx + lbl.get_width() > SCREEN_W - 1:
                lx = ix - lbl.get_width() - 4
            if ly < view_top + 1: ly = view_top + 1
            if ly + lbl.get_height() > view_bot - 1:
                ly = view_bot - 1 - lbl.get_height()
            screen.blit(lbl, (lx, ly))

    # 5. Off-screen target arrow
    tgt = CATALOG[state["target_index"]] if CATALOG else None
    if tgt and tgt.alt >= -1:
        tx, ty = project(tgt.az, tgt.alt)
        if not (0 <= tx < SCREEN_W and view_top <= ty < view_bot):
            draw_offscreen_arrow(tx, ty)

    # 6. Center crosshair
    pygame.draw.line(screen, WHITE, (cx - 5, cy), (cx - 2, cy))
    pygame.draw.line(screen, WHITE, (cx + 2, cy), (cx + 5, cy))
    pygame.draw.line(screen, WHITE, (cx, cy - 5), (cx, cy - 2))
    pygame.draw.line(screen, WHITE, (cx, cy + 2), (cx, cy + 5))

    # 7. Top HUD bar
    pygame.draw.rect(screen, BLACK, (0, 0, SCREEN_W, TOP_H))
    pygame.draw.line(screen, WHITE, (0, TOP_H), (SCREEN_W, TOP_H))

    yaw_s = f"Y{int(state['current_yaw']) % 360:03d}"
    pit_s = f"P{int(state['current_pitch']):+03d}"
    rol_s = f"R{int(state['current_roll']):+02d}"
    hud_l = FONT_TINY.render(f"{yaw_s} {pit_s} {rol_s}", False, WHITE)
    screen.blit(hud_l, (1, 1))

    if tgt:
        hud_r = FONT_TINY.render(tgt.short, False, WHITE)
        screen.blit(hud_r, (SCREEN_W - hud_r.get_width() - 1, 1))

    # 8. Bottom HUD bar
    pygame.draw.line(screen, WHITE, (0, view_bot), (SCREEN_W, view_bot))
    pygame.draw.rect(screen, BLACK, (0, view_bot + 1, SCREEN_W, BOT_H - 1))

    if tgt:
        v_flag = "OK" if tgt.visible else "--"
        info = f"{tgt.short} {tgt.alt:+04.0f}/{tgt.az:03.0f} {v_flag}"
        screen.blit(FONT_TINY.render(info, False, WHITE), (1, view_bot + 2))

    mode_lbl = FONT_TINY.render(state["mode"], False, WHITE)
    screen.blit(mode_lbl, (SCREEN_W - mode_lbl.get_width() - 1, view_bot + 2))

    mag_lbl = FONT_TINY.render(f"m{state['filter_mag']:.1f}", False, WHITE)
    screen.blit(mag_lbl, (SCREEN_W // 2 - mag_lbl.get_width() // 2, view_bot + 2))

    # 9. Calibration banner
    if state["calib_timer"] > 0:
        msg = FONT_BIG.render("CALIBRATED", False, WHITE)
        bx = cx - msg.get_width() // 2
        by = cy - msg.get_height() // 2
        pygame.draw.rect(screen, BLACK, (bx - 3, by - 2, msg.get_width() + 6, msg.get_height() + 4))
        pygame.draw.rect(screen, WHITE, (bx - 3, by - 2, msg.get_width() + 6, msg.get_height() + 4), 1)
        screen.blit(msg, (bx, by))
        state["calib_timer"] -= 1

    # 10. Messaggi a schermo (feedback tasti)
    if state["msg_timer"] > 0:
        msg = FONT_BIG.render(state["msg_text"], False, WHITE)
        bx = cx - msg.get_width() // 2
        by = cy - msg.get_height() // 2
        pygame.draw.rect(screen, BLACK, (bx - 3, by - 2, msg.get_width() + 6, msg.get_height() + 4))
        pygame.draw.rect(screen, WHITE, (bx - 3, by - 2, msg.get_width() + 6, msg.get_height() + 4), 1)
        screen.blit(msg, (bx, by))
        state["msg_timer"] -= 1

    state["blink"] = (state["blink"] + 1) % 60


