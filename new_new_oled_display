            y += 25
            phase_desc = "Waxing" if tgt.is_waxing else "Waning"
            window.blit(DESKTOP_FONT_SM.render(f"Status: {phase_desc}", False, DESKTOP_TEXT), (panel_x + 30, y))
            y += 20

        y += 10
        pygame.draw.line(window, DESKTOP_DIM, (panel_x + 20, y), (DESKTOP_W - 20, y))
        y += 10
        desc_lines = wrap_text(tgt.description, DESKTOP_FONT_SM, DESKTOP_W - panel_x - 40)
        for line in desc_lines:
            window.blit(DESKTOP_FONT_SM.render(line, False, DESKTOP_TEXT), (panel_x + 20, y))
            y += 20

    # --- Bottom Left Controls ---
    # Positioned under the OLED Bezel
    ctrl_x = 40
    ctrl_y = DESKTOP_H - 140
    
    window.blit(DESKTOP_FONT_MED.render("CONTROLS", False, DESKTOP_ACCENT), (ctrl_x, ctrl_y))
    ctrl_y += 25
    ctrl_lines = [
        "[ESC] Exit Program",
        "[SPACE] Next Target",
        "[I] Toggle Info Sheet",
        "[C] Calibrate IMU",
        "[WASD] Pan View (Sim)",
        "[QE] Roll View (Sim)"
    ]
    for line in ctrl_lines:
        window.blit(DESKTOP_FONT_SM.render(line, False, DESKTOP_TEXT), (ctrl_x + 10, ctrl_y))
        ctrl_y += 20


# ============================================================
# MAIN LOOP
# ============================================================
clock = pygame.time.Clock()

print("=== Star Tracker HUD ===")
print("Controls (click on the window to activate them):")
print(" ESC    : Exit program")
print(" SPACE  : Next target")
print(" I      : Toggle Info Page")
print(" C      : Calibrate")
print(" L      : Toggle labels")
print(" N      : Toggle DSO (Nebulae/Galaxies)")
print(" O      : Toggle constellations")
print(" UP/DN  : Magnitude filter")
if not bno:
    print(" WASD   : Move view (PC simulation)")
    print(" Q/E    : Rotate view (PC simulation)")

try:
    while True:
        now = time.time()

        for ev in pygame.event.get():
            if ev.type == pygame.QUIT:
                pygame.quit(); sys.exit()
            if ev.type == pygame.KEYDOWN:
                if ev.key == pygame.K_ESCAPE:
                    pygame.quit(); sys.exit()
                elif ev.key == pygame.K_SPACE:
                    next_target()
                elif ev.key == pygame.K_i:
                    state["show_info"] = not state["show_info"]
                    show_message(f"INFO: {'ON' if state['show_info'] else 'OFF'}")
                elif ev.key == pygame.K_c:
                    do_calibrate()
                elif ev.key == pygame.K_l:
                    state["show_label"] = not state["show_label"]
                    show_message(f"LABELS: {'ON' if state['show_label'] else 'OFF'}")
                elif ev.key == pygame.K_n:
                    state["show_dso"] = not state["show_dso"]
                    show_message(f"DSO: {'ON' if state['show_dso'] else 'OFF'}")
                elif ev.key == pygame.K_o:
                    state["show_const"] = not state["show_const"]
                    show_message(f"CONST: {'ON' if state['show_const'] else 'OFF'}")
                elif ev.key == pygame.K_UP:
                    state["filter_mag"] = min(8.0, state["filter_mag"] + 0.5)
                    show_message(f"MAG <= {state['filter_mag']:.1f}")
                elif ev.key == pygame.K_DOWN:
                    state["filter_mag"] = max(1.0, state["filter_mag"] - 0.5)
                    show_message(f"MAG <= {state['filter_mag']:.1f}")

        # ---- IMU / Desktop simulation controls ----
        if bno:
            try:
                e = bno.euler
                if e[0] is not None:
                    state["raw_yaw"]       = e[0]
                    state["current_yaw"]   = (state["raw_yaw"] + state["yaw_offset"]) % 360
                    state["current_pitch"] = (e[2] or 0.0) + state["pitch_offset"]
                    state["current_roll"]  = (e[1] or 0.0)
            except Exception:
                pass
        else:
            keys = pygame.key.get_pressed()
            if keys[pygame.K_a]: state["current_yaw"] = (state["current_yaw"] - 1.5) % 360
            if keys[pygame.K_d]: state["current_yaw"] = (state["current_yaw"] + 1.5) % 360
            if keys[pygame.K_w]: state["current_pitch"] = min(90, state["current_pitch"] + 1.0)
            if keys[pygame.K_s]: state["current_pitch"] = max(-90, state["current_pitch"] - 1.0)
            if keys[pygame.K_q]: state["current_roll"] = max(-90, state["current_roll"] - 1.0)
            if keys[pygame.K_e]: state["current_roll"] = min(90, state["current_roll"] + 1.0)

        # ---- Astronomy refresh ----
        if now - state["last_astro"] > ASTRO_REFRESH:
            update_positions()
            state["last_astro"] = now

        # ---- Render OLED ----
        render_oled()
        
        # Push to physical OLED
        if HAS_OLED:
            raw = pygame.image.tostring(screen, "RGB")
            pil_img = Image.frombytes("RGB", (SCREEN_W, SCREEN_H), raw).convert("L")
            pil_img = pil_img.point(lambda p: 255 if p > 80 else 0).convert("1")
            oled.display(pil_img)
            
        # ---- Render Desktop Panel ----
        tgt = CATALOG[state["target_index"]] if CATALOG else None
        render_desktop_panel(tgt)
        pygame.display.flip()
        
        clock.tick(FPS)

except KeyboardInterrupt:
    pass
finally:
    if HAS_OLED: oled.clear()
    pygame.quit()
    sys.exit(0)
