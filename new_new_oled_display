WHITE = (255, 255, 255)
BLACK = (0, 0, 0)

def _px(surf, x, y):
    if 0 <= x < SCREEN_W and 0 <= y < SCREEN_H:
        surf.set_at((x, y), WHITE)

def dashed_line(surf, p1, p2, dash=2, gap=1):
    x1, y1 = p1; x2, y2 = p2
    dx, dy = x2 - x1, y2 - y1
    dist = math.hypot(dx, dy)
    if dist < 1: return
    ux, uy = dx / dist, dy / dist
    d = 0
    while d < dist:
        d_end = min(d + dash, dist)
        sx, sy = x1 + ux * d, y1 + uy * d
        ex, ey = x1 + ux * d_end, y1 + uy * d_end
        pygame.draw.line(surf, WHITE, (sx, sy), (ex, ey))
        d += dash + gap

def draw_dashed_circle(surf, cx, cy, r, segs=8):
    for i in range(segs):
        if i % 2 == 0: continue
        a1 = (i / segs) * 2 * math.pi
        a2 = ((i + 1) / segs) * 2 * math.pi
        x1 = cx + math.cos(a1) * r; y1 = cy + math.sin(a1) * r
        x2 = cx + math.cos(a2) * r; y2 = cy + math.sin(a2) * r
        pygame.draw.line(surf, WHITE, (x1, y1), (x2, y2))

def draw_star(surf, x, y, mag):
    if mag < 0:
        for d in range(-2, 3):
            _px(surf, x + d, y); _px(surf, x, y + d)
    elif mag < 1.5:
        _px(surf, x, y); _px(surf, x+1, y)
        _px(surf, x, y+1); _px(surf, x+1, y+1)
    else:
        _px(surf, x, y)

def draw_moon(surf, x, y, phase, waxing):
    r = 4
    b = r * (1.0 - phase / 50.0)
    for dx in range(-r, r + 1):
        for dy in range(-r, r + 1):
            dist_sq = dx*dx + dy*dy
            if dist_sq <= r*r:
                is_lit = False
                if phase == 0:
                    is_lit = False
                elif phase == 100:
                    is_lit = True
                else:
                    x_term = b * math.sqrt(max(0, 1 - (dy*dy)/(r*r)))
                    if waxing:
                        if phase < 50:
                            if dx > -x_term: is_lit = True
                        else:
                            if dx > x_term: is_lit = True
                    else:
                        if phase < 50:
                            if dx < x_term: is_lit = True
                        else:
                            if dx < -x_term: is_lit = True
                if is_lit:
                    _px(surf, x + dx, y + dy)

