    # 1. Compass ticks
    for deg, lbl in [(0, "N"), (90, "E"), (180, "S"), (270, "W")]:
        dx = ((deg - state["current_yaw"] + 180) % 360) - 180
        if abs(dx) < FOV_H_DEG * 0.6:
            x = int(cx + dx * PX_PER_DEG_X)
            pygame.draw.line(screen, WHITE, (x, view_top + 1), (x, view_top + 4))
            blit_text_with_bg(screen, lbl, FONT_TINY, x, view_top + 5, pad_x=1, pad_y=0, align="center")

    # 2. Corner brackets
    draw_corner_brackets()

    # 3. Constellation lines
    if state["show_const"]:
        for a, b in CONSTELLATION_LINES:
            oa = BY_NAME.get(a); ob = BY_NAME.get(b)
            if not oa or not ob: continue
            if oa.alt < -2 or ob.alt < -2: continue
            x1, y1 = project(oa.az, oa.alt)
            x2, y2 = project(ob.az, ob.alt)
            if not (in_view(x1, y1, SCREEN_W, SCREEN_H, 60) or in_view(x2, y2, SCREEN_W, SCREEN_H, 60)):
                continue
            dashed_line(screen, (x1, y1), (x2, y2), dash=2, gap=1)

    # 4. Celestial objects
    for idx, o in enumerate(CATALOG):
        if o.kind == "dso" and not state["show_dso"]: continue
        if o.alt < -1: continue
        if o.mag > state["filter_mag"] and o.name not in ["Sun", "Moon"]: continue
        x, y = project(o.az, o.alt)
        if not in_view(x, y, SCREEN_W, SCREEN_H): continue
        ix, iy = int(x), int(y)
        is_target = (idx == state["target_index"])

        if o.name == "Sun":
            pygame.draw.circle(screen, WHITE, (ix, iy), 4)
            pygame.draw.line(screen, WHITE, (ix-6, iy), (ix-4, iy))
            pygame.draw.line(screen, WHITE, (ix+4, iy), (ix+6, iy))
            pygame.draw.line(screen, WHITE, (ix, iy-6), (ix, iy-4))
            pygame.draw.line(screen, WHITE, (ix, iy+4), (ix, iy+6))
        elif o.name == "Moon":
            draw_moon(screen, ix, iy, o.phase, o.is_waxing)
        elif o.kind == "dso":
            draw_dashed_circle(screen, ix, iy, 3)
        elif o.kind == "planet":
            draw_star(screen, ix, iy, 0.0)
            draw_dashed_circle(screen, ix, iy, 3)
        else:
            draw_star(screen, ix, iy, o.mag)

        if is_target and (state["blink"] // 8) % 2 == 0:
            pygame.draw.rect(screen, WHITE, (ix - 5, iy - 5, 11, 11), 1)
            pygame.draw.line(screen, WHITE, (ix - 7, iy - 7), (ix - 5, iy - 5))
            pygame.draw.line(screen, WHITE, (ix + 5, iy - 7), (ix + 7, iy - 5))
            pygame.draw.line(screen, WHITE, (ix - 7, iy + 7), (ix - 5, iy + 5))
            pygame.draw.line(screen, WHITE, (ix + 5, iy + 7), (ix + 7, iy + 5))

        if state["show_label"] and (o.kind != "star" or o.mag < 1.5 or is_target):
            lbl = FONT_TINY.render(o.short, False, WHITE)
            lw, lh = lbl.get_width(), lbl.get_height()
            lx = ix + 4
            ly = iy - lh // 2
            if lx + lw > SCREEN_W - 1: lx = ix - lw - 4
            if ly < view_top + 1: ly = view_top + 1
            if ly + lh > view_bot - 1: ly = view_bot - 1 - lh
            plate = pygame.Rect(lx - 1, ly, lw + 2, lh)
            pygame.draw.rect(screen, BLACK, plate)
            screen.blit(lbl, (lx, ly))

    # 5. Off-screen target arrow
    if tgt and tgt.alt >= -1:
        tx, ty = project(tgt.az, tgt.alt)
        if not (0 <= tx < SCREEN_W and view_top <= ty < view_bot):
            draw_offscreen_arrow(tx, ty)

    # 6. Center crosshair
    pygame.draw.line(screen, WHITE, (cx - 5, cy), (cx - 2, cy))
    pygame.draw.line(screen, WHITE, (cx + 2, cy), (cx + 5, cy))
    pygame.draw.line(screen, WHITE, (cx, cy - 5), (cx, cy - 2))
    pygame.draw.line(screen, WHITE, (cx, cy + 2), (cx, cy + 5))

    # 7. Top HUD bar
    pygame.draw.rect(screen, BLACK, (0, 0, SCREEN_W, TOP_H))
    pygame.draw.line(screen, WHITE, (0, TOP_H), (SCREEN_W, TOP_H))
    hud_l = FONT_HUD.render(f"Y{int(state['current_yaw'])%360:03d} P{int(state['current_pitch']):+03d} R{int(state['current_roll']):+02d}", False, WHITE)
    screen.blit(hud_l, (1, 2))
    if tgt:
        hud_r = FONT_HUD.render(tgt.short, False, WHITE)
        screen.blit(hud_r, (SCREEN_W - hud_r.get_width() - 1, 2))

    # 8. Bottom HUD bar
    pygame.draw.line(screen, WHITE, (0, view_bot), (SCREEN_W, view_bot))
    pygame.draw.rect(screen, BLACK, (0, view_bot + 1, SCREEN_W, BOT_H - 1))
    if tgt:
        v_flag = "OK" if tgt.visible else "--"
        info = f"{tgt.short} {tgt.alt:+04.0f}/{tgt.az:03.0f} {v_flag}"
        screen.blit(FONT_HUD.render(info, False, WHITE), (1, view_bot + 2))
    mode_lbl = FONT_HUD.render(state["mode"], False, WHITE)
    screen.blit(mode_lbl, (SCREEN_W - mode_lbl.get_width() - 1, view_bot + 2))
    mag_lbl = FONT_HUD.render(f"m{state['filter_mag']:.1f}", False, WHITE)
    screen.blit(mag_lbl, (SCREEN_W // 2 - mag_lbl.get_width() // 2, view_bot + 2))

    # 9. Calibration banner
    if state["calib_timer"] > 0:
        msg = FONT_BIG.render("CALIBRATED", False, WHITE)
        bx = cx - msg.get_width() // 2
        by = cy - msg.get_height() // 2
        plate = pygame.Rect(bx - 4, by - 2, msg.get_width() + 8, msg.get_height() + 4)
        pygame.draw.rect(screen, BLACK, plate)
        pygame.draw.rect(screen, WHITE, plate, 1)
        screen.blit(msg, (bx, by))
        state["calib_timer"] -= 1

    # 10. On-screen messages
    if state["msg_timer"] > 0:
        msg = FONT_BIG.render(state["msg_text"], False, WHITE)
        bx = cx - msg.get_width() // 2
        by = cy - msg.get_height() // 2
        plate = pygame.Rect(bx - 4, by - 2, msg.get_width() + 8, msg.get_height() + 4)
        pygame.draw.rect(screen, BLACK, plate)
        pygame.draw.rect(screen, WHITE, plate, 1)
        screen.blit(msg, (bx, by))
        state["msg_timer"] -= 1

    state["blink"] = (state["blink"] + 1) % 60


# ============================================================
# DESKTOP NATIVE SKY RENDER
# ============================================================
def render_desktop_sky(tgt):
    sky_surf.fill((10, 12, 20))
    cx, cy = SKY_W // 2, SKY_H // 2
    view_top = 35
    view_bot = SKY_H - 35

    # --- INFO PAGE OVERLAY (Desktop Native) ---
    if state["show_info"] and tgt:
        sky_surf.fill((5, 5, 12))
        title = DESKTOP_FONT_TITLE.render(tgt.name, True, (0, 255, 200))
        sky_surf.blit(title, (20, 20))
        pygame.draw.line(sky_surf, (100, 100, 120), (20, 55), (SKY_W - 20, 55), 2)
        
        y = 65
        info_lines = [
            f"Type: {tgt.kind.upper()} ({tgt.sub})",
            f"Constellation: {tgt.constellation}",
            f"Magnitude: {tgt.mag:+.2f}",
            f"Distance: {tgt.distance}"
        ]
        for line in info_lines:
            sky_surf.blit(DESKTOP_FONT_MED.render(line, True, (220, 220, 220)), (20, y))
            y += 25
        
        if tgt.name == "Moon":
            sky_surf.blit(DESKTOP_FONT_MED.render(f"Phase: {tgt.phase:.1f}% ({'Waxing' if tgt.is_waxing else 'Waning'})", True, (255, 80, 80)), (20, y))
            y += 25
            
        pygame.draw.line(sky_surf, (100, 100, 120), (20, y), (SKY_W - 20, y), 1)
        y += 15
        
        desc_lines = wrap_text(tgt.description, DESKTOP_FONT_SKY, SKY_W - 40)
        for line in desc_lines:
            sky_surf.blit(DESKTOP_FONT_SKY.render(line, True, (180, 180, 180)), (20, y))
            y += 18
        return

    # --- LIVE SKYVIEW ---
    # 1. Compass ticks
    for deg, lbl in [(0, "N"), (90, "E"), (180, "S"), (270, "W")]:
        dx = ((deg - state["current_yaw"] + 180) % 360) - 180
        if abs(dx) < FOV_H_DEG * 0.6:
            x = int(cx + dx * (PX_PER_DEG_X * 4))
            pygame.draw.line(sky_surf, (100, 100, 120), (x, view_top + 1), (x, view_top + 6), 2)
            lbl_s = DESKTOP_FONT_SKY.render(lbl, True, (150, 150, 170))
            sky_surf.blit(lbl_s, (x - lbl_s.get_width() // 2, view_top + 10))

    # 2. Corner brackets
    bl = 20
    pygame.draw.line(sky_surf, (100, 100, 120), (5, view_top), (5 + bl, view_top), 2)
    pygame.draw.line(sky_surf, (100, 100, 120), (5, view_top), (5, view_top + bl), 2)
    pygame.draw.line(sky_surf, (100, 100, 120), (SKY_W - 5, view_top), (SKY_W - 5 - bl, view_top), 2)
    pygame.draw.line(sky_surf, (100, 100, 120), (SKY_W - 5, view_top), (SKY_W - 5, view_top + bl), 2)
    pygame.draw.line(sky_surf, (100, 100, 120), (5, view_bot), (5 + bl, view_bot), 2)
    pygame.draw.line(sky_surf, (100, 100, 120), (5, view_bot), (5, view_bot - bl), 2)
    pygame.draw.line(sky_surf, (100, 100, 120), (SKY_W - 5, view_bot), (SKY_W - 5 - bl, view_bot), 2)
    pygame.draw.line(sky_surf, (100, 100, 120), (SKY_W - 5, view_bot), (SKY_W - 5, view_bot - bl), 2)

    # 3. Constellation lines
    if state["show_const"]:
        for a, b in CONSTELLATION_LINES:
            oa = BY_NAME.get(a); ob = BY_NAME.get(b)
            if not oa or not ob: continue
            if oa.alt < -2 or ob.alt < -2: continue
            x1, y1 = project_native(oa.az, oa.alt, SKY_W, SKY_H)
            x2, y2 = project_native(ob.az, ob.alt, SKY_W, SKY_H)
            if not (in_view(x1, y1, SKY_W, SKY_H, 100) or in_view(x2, y2, SKY_W, SKY_H, 100)):
                continue
            pygame.draw.aaline(sky_surf, (40, 50, 80), (x1, y1), (x2, y2))

    # 4. Celestial objects
    for idx, o in enumerate(CATALOG):
        if o.kind == "dso" and not state["show_dso"]: continue
        if o.alt < -1: continue
        if o.mag > state["filter_mag"] and o.name not in ["Sun", "Moon"]: continue
        x, y = project_native(o.az, o.alt, SKY_W, SKY_H)
        if not in_view(x, y, SKY_W, SKY_H): continue
        ix, iy = int(x), int(y)
        is_target = (idx == state["target_index"])

        if o.name == "Sun":
            pygame.draw.circle(sky_surf, (255, 200, 0), (ix, iy), 12)
            pygame.draw.line(sky_surf, (255, 200, 0), (ix-18, iy), (ix-14, iy), 2)
            pygame.draw.line(sky_surf, (255, 200, 0), (ix+14, iy), (ix+18, iy), 2)
            pygame.draw.line(sky_surf, (255, 200, 0), (ix, iy-18), (ix, iy-14), 2)
            pygame.draw.line(sky_surf, (255, 200, 0), (ix, iy+14), (ix, iy+18), 2)
        elif o.name == "Moon":
            r = 14
            b = r * (1.0 - o.phase / 50.0)
            for dx in range(-r, r + 1):
                for dy in range(-r, r + 1):
                    dist_sq = dx*dx + dy*dy
                    if dist_sq <= r*r:
                        is_lit = False
                        if o.phase == 0: is_lit = False
                        elif o.phase == 100: is_lit = True
                        else:
                            x_term = b * math.sqrt(max(0, 1 - (dy*dy)/(r*r)))
                            if o.is_waxing:
                                if o.phase < 50:
                                    if dx > -x_term: is_lit = True
                                else:
                                    if dx > x_term: is_lit = True
                            else:
                                if o.phase < 50:
                                    if dx < x_term: is_lit = True
                                else:
                                    if dx < -x_term: is_lit = True
                        color = (240, 240, 230) if is_lit else (40, 40, 50)
                        sky_surf.set_at((ix + dx, iy + dy), color)
        elif o.kind == "dso":
            pygame.draw.circle(sky_surf, (100, 150, 255), (ix, iy), 8, 1)
        elif o.kind == "planet":
            pygame.draw.circle(sky_surf, (255, 165, 0), (ix, iy), 5)
            pygame.draw.circle(sky_surf, (100, 150, 255), (ix, iy), 10, 1)
        else:
            r = max(1, int(3 - o.mag / 1.5))
            color = (255, 255, 255) if o.mag > 0 else (255, 255, 150)
            pygame.draw.circle(sky_surf, color, (ix, iy), r)
            if o.mag < 1.0:
                pygame.draw.circle(sky_surf, (255, 255, 150, 50), (ix, iy), r+3, 1)

        # Target reticle
        if is_target and (state["blink"] // 8) % 2 == 0:
            pygame.draw.rect(sky_surf, (255, 60, 60), (ix - 12, iy - 12, 24, 24), 2)
            pygame.draw.line(sky_surf, (255, 60, 60), (ix - 18, iy - 18), (ix - 12, iy - 12), 2)
            pygame.draw.line(sky_surf, (255, 60, 60), (ix + 12, iy - 18), (ix + 18, iy - 12), 2)
            pygame.draw.line(sky_surf, (255, 60, 60), (ix - 18, iy + 18), (ix - 12, iy + 12), 2)
            pygame.draw.line(sky_surf, (255, 60, 60), (ix + 12, iy + 18), (ix + 18, iy + 12), 2)

        # Labels
        if state["show_label"] and (o.kind != "star" or o.mag < 1.5 or is_target):
            lbl = DESKTOP_FONT_SKY.render(o.short, True, (200, 200, 200))
            lw, lh = lbl.get_width(), lbl.get_height()
            lx = ix + 10
            ly = iy - lh // 2
            if lx + lw > SKY_W - 5: lx = ix - lw - 10
            if ly < view_top + 1: ly = view_top + 1
            if ly + lh > view_bot - 1: ly = view_bot - 1 - lh
            plate = pygame.Rect(lx - 3, ly - 1, lw + 6, lh + 2)
            pygame.draw.rect(sky_surf, (0, 0, 0), plate)
            sky_surf.blit(lbl, (lx, ly))

    # 5. Off-screen target arrow
    if tgt and tgt.alt >= -1:
        tx, ty = project_native(tgt.az, tgt.alt, SKY_W, SKY_H)
        if not (0 <= tx < SKY_W and view_top <= ty < view_bot):
            dx, dy = tx - cx, ty - cy
            ang = math.atan2(dy, dx)
            rx, ry = SKY_W / 2 - 30, SKY_H / 2 - 40
            sx = abs(math.cos(ang)) or 1e-6
            sy = abs(math.sin(ang)) or 1e-6
            scale = min(rx / sx, ry / sy)
            ix = int(cx + math.cos(ang) * scale)
            iy = int(cy + math.sin(ang) * scale)
            head = 12
            a1 = ang + math.pi - 0.5
            a2 = ang + math.pi + 0.5
            pygame.draw.line(sky_surf, (255, 60, 60), (ix, iy),
                             (int(ix + math.cos(a1) * head), int(iy + math.sin(a1) * head)), 3)
            pygame.draw.line(sky_surf, (255, 60, 60), (ix, iy),
                             (int(ix + math.cos(a2) * head), int(iy + math.sin(a2) * head)), 3)

    # 6. Center crosshair
    pygame.draw.line(sky_surf, (0, 255, 100), (cx - 20, cy), (cx - 8, cy), 2)
    pygame.draw.line(sky_surf, (0, 255, 100), (cx + 8, cy), (cx + 20, cy), 2)
    pygame.draw.line(sky_surf, (0, 255, 100), (cx, cy - 20), (cx, cy - 8), 2)
    pygame.draw.line(sky_surf, (0, 255, 100), (cx, cy + 8), (cx, cy + 20), 2)
    pygame.draw.circle(sky_surf, (0, 255, 100), (cx, cy), 3, 1)

    # 7. Top HUD bar
    pygame.draw.rect(sky_surf, (20, 25, 35), (0, 0, SKY_W, view_top))
    pygame.draw.line(sky_surf, (60, 70, 90), (0, view_top), (SKY_W, view_top), 2)
    hud_l_text = f"YAW {int(state['current_yaw'])%360:03d}°  PITCH {int(state['current_pitch']):+03d}°  ROLL {int(state['current_roll']):+02d}°"
    hud_l = DESKTOP_FONT_MED.render(hud_l_text, True, (0, 255, 200))
    sky_surf.blit(hud_l, (10, 10))
    if tgt:
        hud_r = DESKTOP_FONT_MED.render(f"TGT: {tgt.short}", True, (0, 255, 200))
        sky_surf.blit(hud_r, (SKY_W - hud_r.get_width() - 10, 10))

    # 8. Bottom HUD bar
    pygame.draw.line(sky_surf, (60, 70, 90), (0, view_bot), (SKY_W, view_bot), 2)
    pygame.draw.rect(sky_surf, (20, 25, 35), (0, view_bot + 1, SKY_W, SKY_H - view_bot - 1))
    if tgt:
        v_flag = "VISIBLE" if tgt.visible else "HIDDEN"
        v_color = (0, 255, 100) if tgt.visible else (255, 80, 80)
        info_text = f"{tgt.name}  |  Alt: {tgt.alt:+04.1f}°  Az: {tgt.az:03.0f}°  |  Status: {v_flag}"
        info_lbl = DESKTOP_FONT_MED.render(info_text, True, v_color)
        sky_surf.blit(info_lbl, (10, view_bot + 12))
    mode_lbl = DESKTOP_FONT_MED.render(f"[{state['mode']}]", True, (0, 255, 200))
    sky_surf.blit(mode_lbl, (SKY_W - mode_lbl.get_width() - 10, view_bot + 12))
    mag_lbl = DESKTOP_FONT_MED.render(f"Mag Filter: {state['filter_mag']:.1f}", True, (255, 255, 255))
    sky_surf.blit(mag_lbl, (SKY_W // 2 - mag_lbl.get_width() // 2, view_bot + 12))

    # 9. Calibration banner
    if state["calib_timer"] > 0:
        msg = DESKTOP_FONT_TITLE.render("CALIBRATED", True, (0, 255, 100))
        bx = cx - msg.get_width() // 2
        by = cy - msg.get_height() // 2
        plate = pygame.Rect(bx - 15, by - 10, msg.get_width() + 30, msg.get_height() + 20)
        pygame.draw.rect(sky_surf, (0, 20, 0), plate)
        pygame.draw.rect(sky_surf, (0, 255, 100), plate, 2)
        sky_surf.blit(msg, (bx, by))
        state["calib_timer"] -= 1

    # 10. On-screen messages
    if state["msg_timer"] > 0:
        msg = DESKTOP_FONT_TITLE.render(state["msg_text"], True, (255, 255, 255))
        bx = cx - msg.get_width() // 2
        by = cy - msg.get_height() // 2
        plate = pygame.Rect(bx - 15, by - 10, msg.get_width() + 30, msg.get_height() + 20)
        pygame.draw.rect(sky_surf, (20, 20, 30), plate)
        pygame.draw.rect(sky_surf, (200, 200, 200), plate, 2)
        sky_surf.blit(msg, (bx, by))
        state["msg_timer"] -= 1


